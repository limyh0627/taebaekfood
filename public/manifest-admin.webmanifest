{
  "name": "Flow-It 관리자",
  "short_name": "플로우잇",
  "description": "태백식품 경영 관리 플랫폼",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0891B2",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/png",
            ".png",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "image/webp",
            ".webp",
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
