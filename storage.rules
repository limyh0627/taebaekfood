rules_version = '2';

/**
 * Firebase Storage 보안 규칙
 *
 * 직원 Callable 로그인의 employeeId claim이 있는 세션만 파일에 접근한다.
 */

service firebase.storage {
  match /b/{bucket}/o {
    function isEmployee() {
      return request.auth != null && request.auth.token.employeeId is string;
    }

    function isOwnCompany(companyId) {
      return isEmployee()
        && request.auth.token.companyId is string
        && request.auth.token.companyId == companyId;
    }

    match /companies/{companyId}/file-cabinet/{allPaths=**} {
      allow read: if isOwnCompany(companyId) && request.auth.token.isAdmin == true;
      allow write: if false;
    }
    match /companies/{companyId}/file-cabinet/uploads/{uploadId}/{fileName} {
      function reserved() {
        let r = firestore.get(/databases/(default)/documents/documentUploadReservations/$(uploadId)).data;
        return r.companyId == companyId && r.actorUid == request.auth.uid
          && r.employeeId == request.auth.token.employeeId && r.closed == false
          && r.upload.uploadId == uploadId
          && r.upload.path == 'companies/' + companyId + '/file-cabinet/uploads/' + uploadId + '/' + fileName
          && request.resource.size == r.upload.size && request.resource.size <= 30 * 1024 * 1024
          && request.resource.contentType == r.upload.contentType
          && request.resource.metadata.uploadId == uploadId
          && request.resource.metadata.sha256 == r.upload.sha256
          && request.resource.metadata.actorUid == request.auth.uid
          && request.resource.metadata.employeeId == request.auth.token.employeeId;
      }
      allow create: if isOwnCompany(companyId) && request.auth.token.isAdmin == true && resource == null && reserved();
      allow update, delete: if false;
    }

    match /companies/{companyId}/notices/{postId}/{uploadId} {
      function reservedPhoto() {
        let r = firestore.get(/databases/(default)/documents/noticePhotoUploads/$(uploadId)).data;
        return r.companyId == companyId && r.actorUid == request.auth.uid
          && r.employeeId == request.auth.token.employeeId && r.closed == false
          && r.reference.postId == postId && r.reference.uploadId == uploadId
          && request.resource.size == r.request.size && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType == r.request.contentType
          && request.resource.contentType.matches('image/(jpeg|png|webp)')
          && request.resource.metadata.uploadId == uploadId
          && request.resource.metadata.sha256 == r.request.sha256
          && request.resource.metadata.actorUid == request.auth.uid
          && request.resource.metadata.employeeId == request.auth.token.employeeId;
      }
      allow read: if isOwnCompany(companyId);
      allow create: if resource == null && isOwnCompany(companyId) && request.auth.token.isAdmin == true && reservedPhoto();
      allow update, delete: if false;
    }

    match /companies/{companyId}/officetalk/{allPaths=**} {
      allow read, write: if isOwnCompany(companyId);
    }

    match /companies/{companyId}/items/{itemId}/{fileName} {
      allow read: if isOwnCompany(companyId);
      allow create, update: if isOwnCompany(companyId)
        && request.auth.token.isAdmin == true
        && fileName.matches('photo-[A-Za-z0-9-]+\\.(jpg|jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isOwnCompany(companyId) && request.auth.token.isAdmin == true;
    }

    // 새 파일은 반드시 회사 경로를 지난다. 옛 경로는 이관 검증이 끝날 때까지만 파일이 남고,
    // 앱에서는 더 이상 읽거나 쓰지 않는다. Admin SDK 이관 스크립트만 규칙을 우회해 복사한다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
