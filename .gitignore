# 환경변수 (Firebase 키 등)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 용량 큰 패키지 폴더
node_modules

# 빌드 결과물
/build
/dist
.firebase-local-data/
*-debug.log

# 기타
.DS_Stored
scripts/serviceAccountKey.json
# 운영 DB 백업은 코드가 아니다. 새 스크립트는 로컬전용/백업에 쓰고,
# 옛 스크립트가 실수로 scripts 아래에 만든 파일도 Git에 다시 넣지 않는다.
scripts/*-backup.json
scripts/*-backup-*.json
.tmp/
# 운영 원료 상태 전체가 든 재이관 백업은 이 PC에만 둔다.
scripts/migrate-raw-inventories-v2-backup.json*
# 업로드 안 하는 폴더 — 엑셀 서류·일지·일회성 스크립트(Firebase 키 포함)
로컬전용/
