export function parseArgs(args:string[]){if(args.length===0||args.length===1&&args[0]==='--help')return {mode:'help' as const,values:new Map<string,string>()};const modes=args.filter(value=>['--dry','--apply','--inspect','--undo'].includes(value));check(modes.length===1,'실행 모드 하나를 명시해 주세요.');const values=new Map<string,string>();for(const arg of args){if(modes.includes(arg))continue;const split=arg.indexOf('=');check(split>0);const key=arg.slice(0,split);check(['--snapshot','--directory','--auth','--project','--company','--plan','--approved-plan-hash'].includes(key)&&!values.has(key));values.set(key,arg.slice(split+1));}return {mode:modes[0].slice(2) as 'dry'|'apply'|'inspect'|'undo',values};}
