export function verifySources(reader:(p:string)=>Buffer=readFileSync){check(Object.keys(SOURCE_MANIFEST).length>=5);for(const[p,h]of Object.entries(SOURCE_MANIFEST))check(sha(reader(resolve(workspace,p)))===h);return SOURCE_MANIFEST;}
function obj(v:unknown):asserts v is Record<string,any>{check(v!==null&&typeof v==='object'&&!Array.isArray(v));}
function safe(v:unknown):void{if(v&&typeof v==='object')for(const[k,c]of Object.entries(v)){check(!['__proto__','prototype','constructor','__zeroMigrationType'].includes(k));safe(c);}}
export function documentId(v:unknown):asserts v is string{check(typeof v==='string'&&v.length>0&&v!=='.'&&v!=='..'&&!v.includes('/')&&!/^__.*__$/.test(v)&&Buffer.byteLength(v)<=1500);}
type Collection='items'|'itemReceipts'|'purchaseOrders';
export function parseDocument(original:unknown,collection:Collection,id?:string){check(['items','itemReceipts','purchaseOrders'].includes(collection));obj(original);safe(original);check(isDeepStrictEqual(original,decode(JSON.parse(JSON.stringify(encode(original))))));check(Object.keys(original).every(k=>['name','fields','updateTime','createTime'].includes(k)));const prefix=ROOT+'/'+collection+'/';check(typeof original.name==='string'&&original.name.startsWith(prefix));const found=original.name.slice(prefix.length);documentId(found);if(id!==undefined)check(found===id);timestamp(original.updateTime);if(original.createTime!==undefined)timestamp(original.createTime);const fields=original.fields??{};obj(fields);const data:Record<string,any>=Object.fromEntries(Object.entries(fields).map(([k,v])=>[k,decodeRestValue(v)]));safe(data);check(!Object.hasOwn(data,'id')||data.id===found);return {id:found,data,original};}
export function parseReceipts(body:unknown){check(Array.isArray(body)&&body.length>0);const rows:ReturnType<typeof parseDocument>[]=[],readTimes:string[]=[];for(const[index,row]of body.entries()){obj(row);safe(row);check(Object.keys(row).every(k=>['document','readTime','done','skippedResults'].includes(k)));check(row.skippedResults===undefined||row.skippedResults===0);check(row.done===undefined||typeof row.done==='boolean');if(row.done===true)check(index===body.length-1);if(row.readTime!==undefined){timestamp(row.readTime);readTimes.push(row.readTime);}if(row.document!==undefined){const d=parseDocument(row.document,'itemReceipts');check(d.data.itemId===TARGET);rows.push(d);}else check(row.readTime!==undefined||row.done===true);}check(rows.length<=100&&readTimes.length>0&&new Set(rows.map(r=>r.id)).size===rows.length);return {rows,readTimes};}
export type Observation={collection:'items'|'purchaseOrders';id:string;document:Record<string,any>|null;observedAt:string;serverReadTime:null;notFound?:Record<string,any>};
export interface Ports{get:(collection:'items'|'purchaseOrders',id:string)=>Promise<Observation>;receipts:()=>Promise<unknown>}
export function restPorts(token:string,transport:typeof fetch=fetch):Ports{
 let getCount=0,queryCount=0;
 const request=async(url:string,init:RequestInit)=>guarded('query',()=>transport(url,{...init,headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},redirect:'error',signal:AbortSignal.timeout(60000)}));
 return {get:async(collection,id)=>{guard('query',()=>{check(['items','purchaseOrders'].includes(collection));documentId(id);if(collection==='items')check(id===TARGET);check(++getCount<=102);});const r=await request('https://firestore.googleapis.com/v1/'+ROOT+'/'+collection+'/'+encodeURIComponent(id),{method:'GET'});return guarded('restshape',async()=>{const body=await r.json(),observedAt=new Date().toISOString();if(r.status===404){obj(body);safe(body);check(body.error?.code===404&&body.error?.status==='NOT_FOUND');return {collection,id,document:null,notFound:body,observedAt,serverReadTime:null};}check(r.ok);parseDocument(body,collection,id);return {collection,id,document:body,observedAt,serverReadTime:null};});},receipts:async()=>{guard('query',()=>check(++queryCount===1));const r=await request('https://firestore.googleapis.com/v1/'+ROOT+':runQuery',{method:'POST',body:JSON.stringify({structuredQuery:{from:[{collectionId:'itemReceipts',allDescendants:false}],where:{fieldFilter:{field:{fieldPath:'itemId'},op:'EQUAL',value:{stringValue:TARGET}}},limit:101}})});guard('query',()=>check(r.ok));return guarded('restshape',async()=>{const body=await r.json();parseReceipts(body);return body;});}};
}
const companyOf=(d:Record<string,any>)=>d.companyId??'taebaek';
export function inspectItem(original:Record<string,any>){const row=parseDocument(original,'items',TARGET),d=row.data;check(companyOf(d)==='taebaek');check(d.lots===undefined||Array.isArray(d.lots));const lots=d.lots??[];check(lots.length<=1000);const seen=new Set<string>();for(const lot of lots){obj(lot);documentId(lot.id);check(!seen.has(lot.id));seen.add(lot.id);check(['active','depleted'].includes(lot.status));check(lot.qtyRemaining===undefined||typeof lot.qtyRemaining==='number'&&Number.isFinite(lot.qtyRemaining)&&lot.qtyRemaining>=0);}
 const poIds=[...new Set<string>(lots.flatMap((l:any)=>l.poId===undefined||l.poId===''?[]:[l.poId]))];check(poIds.length<=100);poIds.forEach(documentId);
 const active=lots.filter((l:any)=>l.status==='active'),quantityComplete=active.every((l:any)=>typeof l.qtyRemaining==='number'&&Number.isFinite(l.qtyRemaining));const stockValid=typeof d.stock==='number'&&Number.isFinite(d.stock);const quantityComparable=quantityComplete&&stockValid;const activeQty=quantityComparable?lotQtyRemaining(active):null;check(activeQty===null||Number.isFinite(activeQty));
 return {row,poIds,measurement:{archived:d.archived===true,stockValid,activeLots:active.length,totalLots:lots.length,quantityComplete,quantityComparable,activeQty,stock:stockValid?d.stock:null,delta:quantityComparable?d.stock-activeQty!:null,unit:typeof d.unit==='string'?d.unit:null,lotQuantityUnit:'stored-item-count',physicalStockVerified:false}};
}
