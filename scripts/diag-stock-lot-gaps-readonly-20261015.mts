export async function run(args:string[],deps={source:selfCheck,path:outputPath,token:cliToken,ports:restPorts,write:(p:string,text:string)=>writeFileSync(p,text,{flag:'wx'})}){const input=guard('arguments',()=>options(args)),p=guard('paths',()=>deps.path(input));guard('source',()=>deps.source());const token=await guarded('auth',()=>deps.token()),result=await guarded('calculation',()=>collect(deps.ports(token)));const payload={readOnly:true,encoding:'zeroItemPriceBackup.encode-v1',scope:{companyId:'taebaek',itemId:TARGET,singlePilot:true,maxGets:102,maxReceiptRows:100,maxLots:1000},toolSourceSha256:sha(readFileSync(fileURLToPath(import.meta.url))),sourceManifest:SOURCE_MANIFEST,inputHash:hash(result),result,summary:summary(result),limitations:['original-thirteen-item-ids-unavailable','stored-current-quantity-only','no-physical-stock-check','no-history-reconstruction','no-outbound-proof-without-explicit-source','mixed-observation-times-not-atomic','missing-receipts-do-not-prove-missing-stock','po-item-company-identity-is-not-receipt-validation']};guard('output',()=>deps.write(p,JSON.stringify(encode(payload),null,2)));return summary(result);}
