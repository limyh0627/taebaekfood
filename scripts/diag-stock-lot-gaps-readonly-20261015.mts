export async function collect(ports:Ports){const observations:Observation[]=[];const read=async(collection:'items'|'purchaseOrders',id:string)=>{const o=await ports.get(collection,id);check(o.collection===collection&&o.id===id&&o.serverReadTime===null);timestamp(o.observedAt);if(o.document)parseDocument(o.document,collection,id);else{check(o.document===null&&o.notFound?.error?.code===404&&o.notFound?.error?.status==='NOT_FOUND');safe(o.notFound);}observations.push(o);return o;};
 const start=await read('items',TARGET);let queryOriginal:unknown=null,measurement:ReturnType<typeof inspectItem>['measurement']|null=null,receiptSummary={total:0,ownCompany:0,otherCompany:0},poLinks:{poId:string;exists:boolean;identityLinked:boolean}[]=[];
 if(start.document){const initial=inspectItem(start.document);measurement=initial.measurement;queryOriginal=await ports.receipts();const receipts=parseReceipts(queryOriginal);receiptSummary={total:receipts.rows.length,ownCompany:receipts.rows.filter(r=>companyOf(r.data)==='taebaek').length,otherCompany:receipts.rows.filter(r=>companyOf(r.data)!=='taebaek').length};for(const id of initial.poIds){const o=await read('purchaseOrders',id);poLinks.push({poId:id,exists:o.document!==null,identityLinked:o.document?comparePo(o.document).identityLinked:false});}}
 const end=await read('items',TARGET),unchanged=isDeepStrictEqual(start.document,end.document);const classification=!unchanged?'changed-during-read':!start.document?'item-not-found':!measurement!.quantityComparable?'quantity-unconfirmed':measurement!.stock!>0&&measurement!.activeLots===0?'positive-stock-without-active-lots':measurement!.delta===0?'stored-quantity-equal':'stored-quantity-different';
 return {observations,queryOriginal,receiptSummary,poLinks,measurement:unchanged?measurement:null,classification,unchanged,currentOnly:true,atomicSnapshot:false,physicalStockVerified:false,oldThirteenItemCohortVerified:false};
}
