type Stage='arguments'|'paths'|'source'|'auth'|'query'|'restshape'|'calculation'|'output';
class Failure extends Error{constructor(readonly stage:Stage){super('읽기 진단 실패');}}
function check(v:unknown):asserts v{if(!v)throw Error('읽기 검증 실패');}
