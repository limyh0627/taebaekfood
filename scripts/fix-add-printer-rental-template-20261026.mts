const canonical=(value:unknown):unknown=>Array.isArray(value)?value.map(canonical):value&&typeof value==='object'?Object.fromEntries(Object.entries(value).sort(([a],[b])=>a.localeCompare(b)).map(([k,v])=>[k,canonical(v)])):value;
export const hash=(value:unknown)=>createHash('sha256').update(JSON.stringify(canonical(value))).digest('hex');
const clone=<T,>(value:T):T=>JSON.parse(JSON.stringify(value));
function check(value:unknown,message='승인한 회사·원문·계획 조건이 다릅니다.'):asserts value{if(!value)throw Error(message);}
const field=(doc:Document,key:string,kind='stringValue')=>(doc.fields[key] as Record<string,unknown>|undefined)?.[kind];
