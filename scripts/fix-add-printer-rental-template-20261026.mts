export function parseArgs(args:string[]){const modes=args.filter(a=>['--dry','--apply','--undo'].includes(a));check(modes.length<=1,'--dry/--apply/--undo는 서로 배타적입니다.');const values=new Map<string,string>();for(const arg of args){if(modes.includes(arg))continue;const at=arg.indexOf('=');check(at>0);const k=arg.slice(0,at);check(['--company','--auth','--approved-hash','--directory'].includes(k)&&!values.has(k));values.set(k,arg.slice(at+1));}const mode=modes[0]??'--dry',company=values.get('--company');check(company===undefined||company==='taebaek','태백 새 1건만 승인되었습니다.');check(mode==='--dry'||company==='taebaek');check(mode==='--dry'||/^[a-f0-9]{64}$/.test(values.get('--approved-hash')??''));const directory=resolve(values.get('--directory')??'privatework/printer-template'),base=resolve('privatework/printer-template');check(directory===base||directory.startsWith(base+sep),'운영 원문은 지정된 private 폴더에만 보관합니다.');check(values.get('--auth')===undefined||values.get('--auth')==='firebase-cli');return{mode,company,approvedHash:values.get('--approved-hash'),directory};}
async function main(){const input=parseArgs(process.argv.slice(2));if(!input.company){console.log(JSON.stringify({status:'company-required',writes:0}));return;}check(!process.env.FIRESTORE_EMULATOR_HOST&&!process.env.FIREBASE_AUTH_EMULATOR_HOST,'운영 CLI와 emulator를 혼용하지 않습니다.');const {cliToken}=await import('./diag-zero-item-price-20261015.mts');const token=await cliToken();
 const request=async(url:string,init:RequestInit={})=>{const response=await fetch(url,{...init,headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},redirect:'error',signal:AbortSignal.timeout(60000)});if(!response.ok)throw Error('Firestore 요청 실패 HTTP '+response.status);return response.json();};
 const port:Port={get:async name=>{check(name===TARGET);const response=await fetch('https://firestore.googleapis.com/v1/'+name,{headers:{Authorization:'Bearer '+token},redirect:'error',signal:AbortSignal.timeout(60000)});if(response.status===404)return null;if(!response.ok)throw Error('문서 조회 실패 HTTP '+response.status);return response.json();},list:async collection=>{let page='',docs:Document[]=[];const seen=new Set<string>();do{check(!seen.has(page),'페이지 토큰이 반복됩니다.');seen.add(page);const result=await request(`https://firestore.googleapis.com/v1/${ROOT}/${collection}?pageSize=300${page?'&pageToken='+encodeURIComponent(page):''}`) as {documents?:Document[];nextPageToken?:string};docs.push(...(result.documents??[]));page=result.nextPageToken??'';}while(page);return docs;},commit:writes=>request(`https://firestore.googleapis.com/v1/projects/${PROJECT}/databases/(default)/documents:commit`,{method:'POST',body:JSON.stringify({writes})})};
 mkdirSync(input.directory,{recursive:true});const disk:Disk={read:name=>{const path=resolve(input.directory,name);return existsSync(path)?JSON.parse(readFileSync(path,'utf8').replace(/^\uFEFF/,'')):null;},writeExclusive:(name,value)=>writeFileSync(resolve(input.directory,name),JSON.stringify(value,null,2),{flag:'wx'})};let report;
 if(input.mode==='--dry')report=await dry(input.company,port,disk);else{const plan=disk.read('plan.json') as Plan;report=input.mode==='--apply'?await apply(plan,input.company,input.approvedHash!,port,disk):await undo(plan,input.company,input.approvedHash!,port,disk);}console.log(JSON.stringify({...report,directory:input.directory}));if(!['ready','applied','already-applied','undone','already-absent'].includes(report.status))process.exitCode=2;
}
if(process.argv[1]&&import.meta.url===pathToFileURL(resolve(process.argv[1])).href)main().catch(()=>{console.error('프린터 양식 처리를 마치지 못했습니다. 비공개 계획·intent와 현재 문서를 확인하세요. 자격증명과 운영 원문은 출력하지 않습니다.');process.exitCode=1;});
