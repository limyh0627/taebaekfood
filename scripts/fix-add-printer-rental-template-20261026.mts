export function version(value:string){const match=/^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,9}))?Z$/.exec(value);check(match,'나노초 원문 버전이 없습니다.');const ms=Date.parse(match[1]+'Z');check(Number.isFinite(ms)&&new Date(ms).toISOString().slice(0,19)===match[1]);return{seconds:ms/1000,nanoseconds:Number((match[2]??'').padEnd(9,'0'))};}
function document(doc:Document,collection:string){check(doc&&typeof doc.name==='string'&&doc.name.startsWith(ROOT+'/'+collection+'/')&&doc.name.slice((ROOT+'/'+collection+'/').length).length>0&&!doc.name.slice((ROOT+'/'+collection+'/').length).includes('/'));check(doc.fields&&typeof doc.fields==='object'&&!Array.isArray(doc.fields));version(doc.updateTime);}
export function printerFields():Fields{return{companyId:{stringValue:'taebaek'},name:{stringValue:'프린터렌탈료'},itemName:{stringValue:'프린터렌탈료'},amount:{integerValue:'33000'},accountCode:{stringValue:'819'},kind:{stringValue:'voucher'},mode:{stringValue:'일반'},dir:{stringValue:'대체'},statementType:{stringValue:'매입'},group:{stringValue:'고정비'},category:{stringValue:'기타'},taxExempt:{booleanValue:false},autoIssue:{booleanValue:false},active:{booleanValue:false},hidden:{booleanValue:false}};}
function account(accounts:Document[]){const rows=accounts.filter(d=>field(d,'companyId')==='taebaek'&&field(d,'code')==='819');check(rows.length===1,'태백 819 계정이 없거나 중복입니다.');document(rows[0],'accountCodes');check(field(rows[0],'name')==='임차료','태백 819 임차료 계정을 확인하지 못했습니다.');return rows[0];}
function duplicates(templates:Document[],ignoreTarget=false){const seen=new Set<string>();return templates.filter(doc=>{document(doc,'fixedCostTemplates');check(!seen.has(doc.name),'템플릿 전체 조회에 중복 문서가 있습니다.');seen.add(doc.name);if(ignoreTarget&&doc.name===TARGET)return false;if(field(doc,'companyId')==='punghoe')return false;const name=String(field(doc,'name')??'')+' '+String(field(doc,'itemName')??'');return doc.name===TARGET||/프린터|프린트|복합기|printer/i.test(name)||field(doc,'amount','integerValue')==='33000'&&field(doc,'accountCode')==='819';});}
export function buildPlan(observation:Observation,company?:string):Plan{
 check(company==='taebaek','사용자가 지정한 태백 회사만 계획할 수 있습니다.');check(observation&&Array.isArray(observation.accounts)&&Array.isArray(observation.templates));account(observation.accounts);check(!observation.target&&duplicates(observation.templates).length===0,'같은 목적 ID 또는 유사 프린터·동액 임차료 양식이 있습니다. 기존 행을 덮지 않고 검토하세요.');check(Number.isFinite(Date.parse(observation.observedAt)));
 const body={version:1 as const,purpose:'taebaek-printer-rental-33000' as const,projectId:PROJECT,companyId:'taebaek' as const,approval:APPROVAL,target:TARGET,afterFields:printerFields(),observation:clone(observation)};return{...body,hash:hash(body)};
}
export function validatePlan(plan:Plan,approvedHash?:string){check(plan&&plan.version===1&&plan.purpose==='taebaek-printer-rental-33000'&&plan.projectId===PROJECT&&plan.companyId==='taebaek'&&plan.approval===APPROVAL&&plan.target===TARGET);check(same(plan.afterFields,printerFields()),'정확한 33000원 프린터 양식 필드가 아닙니다.');const {hash:saved,...body}=plan;check(saved===hash(body)&&(!approvedHash||approvedHash===saved),'계획 hash가 달라졌습니다.');check(buildPlan(plan.observation,'taebaek').hash===saved);}
const intentKey=(plan:Plan,mode:'apply'|'undo')=>`${mode}-intent-${plan.hash}.json`;
const receiptKey=(plan:Plan)=>`apply-receipt-${plan.hash}.json`;
function preserve(disk:Disk,name:string,value:unknown){const saved=disk.read(name);if(saved!==null){check(same(saved,value),'보관된 계획·백업 원문을 덮지 않습니다.');return;}disk.writeExclusive(name,value);}
function receipt(plan:Plan,value:unknown):Receipt{const r=value as Receipt;check(r&&r.version===1&&r.mode==='apply'&&r.planHash===plan.hash&&r.target===TARGET&&r.responseConfirmed===true&&same(r.afterFields,plan.afterFields),'최초 적용의 원문·버전 증거가 없습니다.');const {hash:saved,...body}=r;check(saved===hash(body),'적용 영수증 원문이 바뀌었습니다.');version(r.writeUpdateTime);if(r.observed)document(r.observed,'fixedCostTemplates');return r;}
function intent(plan:Plan,value:unknown,mode:'apply'|'undo'){const i=value as {version:number;mode:string;planHash:string;target:string};check(i&&i.version===1&&i.mode===mode&&i.planHash===plan.hash&&i.target===TARGET,'보관된 실행 의도가 손상되었습니다. 재송신하지 않습니다.');}
function currentMatches(plan:Plan,doc:Document|null){if(!doc)return false;document(doc,'fixedCostTemplates');check(doc.name===TARGET);return same(doc.fields,plan.afterFields);}
export async function observe(port:Port):Promise<Observation>{const [accounts,templates,target]=await Promise.all([port.list('accountCodes'),port.list('fixedCostTemplates'),port.get(TARGET)]);return{observedAt:new Date().toISOString(),accounts,templates,target};}
export async function dry(company:string|undefined,port:Port,disk:Disk){if(company===undefined)return{status:'company-required',writes:0,responseConfirmed:false,message:'회사 지정 전에는 계획과 인증·조회·쓰기를 시작하지 않습니다.'};check(company==='taebaek');const observation=await observe(port);const plan=buildPlan(observation,company);preserve(disk,'plan.json',plan);preserve(disk,`backup-${plan.hash}.json`,plan.observation);return{status:'ready',writes:0,responseConfirmed:false,planHash:plan.hash,message:'태백 프린터렌탈료 33000원 새 양식 1건 계획만 보관했습니다.'};}
export async function apply(plan:Plan,company:string|undefined,approvedHash:string,port:Port,disk:Disk):Promise<Report>{
 check(company==='taebaek'&&approvedHash===plan.hash);validatePlan(plan,approvedHash);preserve(disk,'plan.json',plan);preserve(disk,`backup-${plan.hash}.json`,plan.observation);
 const savedReceipt=disk.read(receiptKey(plan)),savedIntent=disk.read(intentKey(plan,'apply')),target=await port.get(TARGET);
 if(savedReceipt!==null){const r=receipt(plan,savedReceipt);return{status:currentMatches(plan,target)&&target!.updateTime===r.writeUpdateTime?'already-applied':'conflict',writes:0,responseConfirmed:true,receiptSaved:true,message:'같은 계획의 기존 적용 증거와 현재 문서만 조회했습니다. 추가 create를 보내지 않았습니다.'};}
 if(savedIntent!==null){intent(plan,savedIntent,'apply');return{status:currentMatches(plan,target)?'observed-identical':'unknown',writes:0,responseConfirmed:false,message:'이전 요청의 응답이 미확인입니다. 같은 ID만 조회했으며 재송신하지 않았습니다. 적용 소유 버전 증거가 없어 undo하지 않습니다.'};}
 if(target)return{status:currentMatches(plan,target)?'observed-identical':'conflict',writes:0,responseConfirmed:false,message:'목적 ID가 이미 있습니다. 덮거나 새 ID로 만들지 않습니다. 적용 소유 버전 증거 없이 undo하지 않습니다.'};
 const fresh=await observe(port);check(!fresh.target&&duplicates(fresh.templates).length===0,'새 중복 또는 목적 문서가 생겼습니다. 전송하지 않았습니다.');check(same(account(fresh.accounts),account(plan.observation.accounts)),'819 계정 원문·버전이 바뀌었습니다. 새 계획을 확인하세요.');preserve(disk,`apply-observation-${plan.hash}.json`,fresh);
 disk.writeExclusive(intentKey(plan,'apply'),{version:1,mode:'apply',planHash:plan.hash,target:TARGET});
 let response:{writeResults?:{updateTime?:string}[]};try{response=await port.commit([{update:{name:TARGET,fields:clone(plan.afterFields)},currentDocument:{exists:false}}]);}catch{let observed:Document|null=null;try{observed=await port.get(TARGET);preserve(disk,`apply-unknown-${plan.hash}.json`,{planHash:plan.hash,observed});}catch{/* 응답 유실과 재조회 실패를 성공으로 바꾸지 않는다. */}return{status:currentMatches(plan,observed)?'observed-identical':'unknown',writes:1,responseConfirmed:false,message:'요청 응답을 확인하지 못했습니다. 동일 ID 재조회만 했으며 자동으로 다시 보내지 않았습니다.'};}
 let updateTime:string;try{check(response.writeResults?.length===1);updateTime=response.writeResults[0].updateTime!;version(updateTime);}catch{return{status:'unknown',writes:1,responseConfirmed:false,message:'응답의 적용 버전을 확인하지 못했습니다. intent를 유지하고 같은 ID만 조회하세요. 재송신·undo하지 않습니다.'};}
 let observed:Document|null=null,observationFailed=false;try{observed=await port.get(TARGET);}catch{observationFailed=true;}
 const body={version:1 as const,mode:'apply' as const,planHash:plan.hash,target:TARGET,responseConfirmed:true as const,afterFields:clone(plan.afterFields),writeUpdateTime:updateTime,observed,observationFailed};const proof:Receipt={...body,hash:hash(body)};let receiptSaved=true;try{disk.writeExclusive(receiptKey(plan),proof);}catch{receiptSaved=false;}
 return{status:!receiptSaved?'applied-receipt-failed':currentMatches(plan,observed)&&observed!.updateTime===updateTime?'applied':'applied-verification-pending',writes:1,responseConfirmed:true,receiptSaved,message:!receiptSaved?'서버 create 응답은 확인했지만 기기 영수증 보관에 실패했습니다. 재송신하지 말고 같은 ID를 조회하세요. 영수증 없이 undo하지 않습니다.':'서버 create 응답과 원문 버전을 보관했습니다. 현재 문서 재조회 결과와 후속 수정을 구분해 확인하세요.'};
}
export async function undo(plan:Plan,company:string|undefined,approvedHash:string,port:Port,disk:Disk):Promise<Report>{
 check(company==='taebaek'&&approvedHash===plan.hash);validatePlan(plan,approvedHash);const r=receipt(plan,disk.read(receiptKey(plan)));check(r.observed&&r.observed.name===TARGET&&same(r.observed.fields,r.afterFields)&&r.observed.updateTime===r.writeUpdateTime&&!r.observationFailed,'최초 적용 직후 원문·버전 대조 증거가 불완전합니다. undo하지 않습니다.');const current=await port.get(TARGET);
 if(!current)return{status:'already-absent',writes:0,responseConfirmed:false,message:'현재 문서가 없습니다. 다시 삭제하지 않았습니다.'};
 check(currentMatches(plan,current)&&same(version(current.updateTime),version(r.writeUpdateTime)),'후속 수정 또는 삭제 후 재생성 버전입니다. 삭제하지 않았습니다.');
 const savedIntent=disk.read(intentKey(plan,'undo'));if(savedIntent!==null){intent(plan,savedIntent,'undo');return{status:'unknown',writes:0,responseConfirmed:false,message:'이전 undo 응답이 미확인입니다. 재삭제하지 않고 현재 문서만 확인했습니다.'};}
 preserve(disk,`undo-before-${plan.hash}.json`,current);disk.writeExclusive(intentKey(plan,'undo'),{version:1,mode:'undo',planHash:plan.hash,target:TARGET});
 try{await port.commit([{delete:TARGET,currentDocument:{updateTime:r.writeUpdateTime}}]);}catch{return{status:'unknown',writes:1,responseConfirmed:false,message:'undo 응답을 확인하지 못했습니다. 같은 ID만 다시 조회하고 삭제를 재송신하지 마세요.'};}
 let after:Document|null;try{after=await port.get(TARGET);}catch{return{status:'undone-verification-pending',writes:1,responseConfirmed:true,message:'삭제 응답은 확인했지만 후속 조회에 실패했습니다. 재삭제하지 마세요.'};}
