 const version=start.original?timestamp(start.original.updateTime):null,baselineVersion=baseline.original.orderVersion;
 return {start,base,linked,end,references,linkChecks:orderUnchanged?linkChecks:linkChecks.map(c=>({...c,status:'unconfirmed-order-changed'})),orderUnchanged,baselineVersionChanged:version===null||version.seconds!==baselineVersion.seconds||version.nanoseconds!==baselineVersion.nanoseconds,changedFields,classification:!orderUnchanged?'unknown-order-changed-or-missing':references.ledgerIds.length||references.jobIds.length?'current-explicit-references-observed':'no-new-explicit-reference-historical-source-unconfirmed'};
