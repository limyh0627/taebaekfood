export async function readCurrent(token:string,baseline:ReturnType<typeof loadBaseline>,transport:typeof fetch=fetch){const start=await asyncGuard('base',()=>getObserved(token,'orders',TARGET.orderId,transport));let references:ReturnType<typeof collectReferences>={ledgerIds:[],jobIds:[],operationIds:[],incompleteTraces:0};if(start.original)references=guard('links',()=>collectReferences(parseDocument(start.original,'orders',TARGET.orderId).data));
