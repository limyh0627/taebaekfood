 const linkChecks=linked.map(o=>{if(!o.original)return {collection:o.collection,id:o.id,status:'not-found'};const data=parseDocument(o.original,o.collection,o.id).data;const orderLinked=data.source?.id===TARGET.orderId||o.collection==='rawMaterialLedger'&&data.orderId===TARGET.orderId;const operationLinked=o.collection==='rawInventoryJobs'||typeof data.operationId==='string'&&references.operationIds.includes(data.operationId);return {collection:o.collection,id:o.id,status:orderLinked&&operationLinked?'reference-linked':'unconfirmed',orderLinked,operationLinked};});
 const end=await asyncGuard('final',()=>getObserved(token,'orders',TARGET.orderId,transport)),orderUnchanged=start.original!==null&&end.original!==null&&isDeepStrictEqual(start.original,end.original);const current=start.original?parseDocument(start.original,'orders',TARGET.orderId).data:null;
