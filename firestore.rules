rules_version = '2';
/**
 * Firestore 보안 규칙 — **회사별·메뉴별 권한판**
 *
 * 2026-09-16 코덱스 인수인계 · 사장님: **회사별 권한과 메뉴별 권한을 규칙에서 실제로
 * 강제할 것. 화면 메뉴 숨김만으로 끝내면 안 된다.**
 *
 * 앱·Functions를 먼저 배포하고 이 규칙을 마지막에 배포한다.
 * 시험은 `src/rules/firestore.rules.test.ts`가 이 파일을 직접 읽는다.
 *
 * ─ 무엇이 바뀌나 ─
 * 지금 규칙은 **로그인한 직원이면 업무 데이터가 전부 열린다.** 태백 직원이 풍회 전표를
 * 읽을 수 있고, 일반 직원이 자금원장·급여를 읽을 수 있다. 여기서 둘을 막는다:
 *
 *   회사   **내 회사 문서만. 관리자도 못 넘는다** — 회사마다 관리자 계정이 따로 있다.
 *   메뉴   돈·인사·서류는 관리자만. 현장(주문·재고·품목·오피스톡)은 직원도.
 *
 * ─ 규칙은 필터가 아니다 ─
 * `list` 질의는 **질의 자체가** 규칙을 만족해야 통과한다. 전체 컬렉션을 구독한 채 규칙만
 * 잠그면 목록 조회가 통째로 `permission-denied` 난다. 그래서 `useAppData` 가 모든 구독에
 * `where('companyId','==',companyId)` 를 붙인다(코덱스 작업). 그 짝이 안 맞으면 화면이 빈다.
 *
 * ─ claim ─
 * `employeeLogin` Callable 이 `employeeId` · `companyId` · `isAdmin` 을 발급한다.
 * `allowedCompanies` 는 **필요 없다** — 한 계정은 한 회사에만 속한다.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 누구인가 ────────────────────────────────────────────────
    function isEmployee() {
      return request.auth != null && request.auth.token.employeeId is string;
    }
    function isAdmin() {
      return isEmployee() && request.auth.token.isAdmin == true;
    }
    function myCompany() {
      return request.auth.token.companyId;
    }
    function me() {
      return request.auth.token.employeeId;
    }

    // ── 어느 회사 것인가 ────────────────────────────────────────
    /**
     * **회사 경계는 관리자도 못 넘는다**(2026-09-16 사장님: "관리자가 회사를 골라보는
     * 구조가 아니잖아 지금 관리자 계정은 그냥 회사 내의 관리자 아니야?").
     *
     * 운영 계정이 그 모양이다 — `admin`(태백)과 `admin-punghoe`(풍회)가 **따로** 있고,
     * 이은경 상무도 `lek861215`(태백)·`lek861215_p`(풍회) 두 계정이다. 회사를 바꾸려면
     * **그 회사 계정으로 로그인**한다.
     *
     * 그래서 `isAdmin` 은 **메뉴만** 가른다(돈·인사·서류). 회사 경계를 넘는 열쇠가 아니다.
     * 처음엔 관리자를 양쪽 다 보게 짰는데, 그러면 태백 관리자가 풍회 장부를 읽는다.
     *
     * 회사값이 없는 문서는 아무도 못 본다 — 목록에 없으면 거짓이다.
     */
    function canSee(company) {
      return company in ['taebaek', 'punghoe'] && company == myCompany();
    }
    function readOk() {
      return isEmployee() && canSee(resource.data.companyId);
    }
    // 원자화된 재고 명령은 중복 실행을 막으려고 결정적 ID의 문서가 아직 없는지 먼저 get 한다.
    // 없는 문서는 회사값 자체가 없으므로 get만 허용한다. 실제 문서가 있으면 기존 회사 경계를 그대로 적용한다.
    function getOk() {
      return isEmployee() && (resource == null || canSee(resource.data.companyId));
    }
    /**
     * 만들기·고치기 — **들어오는 값과 저장된 값을 둘 다** 본다.
     * 들어오는 값만 보면 풍회 문서를 태백으로 덮어써 제 것으로 만들 수 있고,
     * 저장된 값만 보면 내 회사 문서를 남의 회사로 넘길 수 있다.
     */
    function createUpdateOk() {
      return isEmployee()
             && canSee(request.resource.data.companyId)
             && (resource == null || canSee(resource.data.companyId));
    }
    // 과거 음수 재고는 입고·실사로 0에 가까워져야 한다. 새 음수와 부족량 악화만 막는다.
    function nonnegativeWhenWritten(field) {
      return (resource == null
                ? !(field in request.resource.data)
                : !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]))
             || (request.resource.data[field] is number
                 && (request.resource.data[field] >= 0
                     || (resource != null
                         && resource.data[field] is number
                         && resource.data[field] < 0
                         && request.resource.data[field] >= resource.data[field])));
    }
    function inventoryQuantityOk(collection) {
      return (collection != 'items' || nonnegativeWhenWritten('stock'))
             && (collection != 'rawInventories' || nonnegativeWhenWritten('stockKg'));
    }
    //  **지우기에는 들어오는 값이 없다**(`request.resource` 가 null) — 저장된 값만 본다.
    //  `createUpdateOk` 를 그대로 쓰면 지우기가 통째로 막힌다(시험이 잡았다).
    function deleteOk() {
      return isEmployee() && canSee(resource.data.companyId);
    }

    // ── 메뉴별 — 돈·인사·서류는 관리자만 ─────────────────────────
    //  사장님이 정한 관리자 전용 메뉴 그대로다: 전표·세금계산서·견적, 인사관리, 문서함,
    //  현금출납장·거래처원장·제품별원장, 재무제표, 분석 화면들.
    function serverAuditCollection(c) {
      return c in ['partnerItemCleanupReceipts', 'retirementProfiles', 'retirementEvents', 'retirementCommandReceipts', 'manualSettlementOperations', 'partnerPaymentOperations', 'manualSettlementBatchOperations',
                   'loanMovementOperations', 'returnOperations', 'voucherMutationOperations',
                   'orderLockRecoveryOperations', 'companyTransferOperations', 'oemReceiptOperations', 'partnerAdvanceOperations', 'financialOpeningOperations', 'returnSubmissionOperations', 'taxIssueOperations'];
    }
    function adminOnlyCollection(c) {
      return serverAuditCollection(c) || c in [
        'issuedStatements', 'pendingStatementEdits', 'settlements', 'quotations',
        'cashEntries', 'cashAccounts', 'cashFlowManual', 'loanContracts',
        'payrolls', 'fixedCosts', 'fixedCostTemplates', 'expensePresets',
        'accountCodes', 'accountGroups',
        'inventorySnapshots', 'openingBalances', 'productionSalesLogs',
        //  **실제 컬렉션 이름이다**(2026-09-16 코덱스 검수 3번). `fileCabinet` 하나로 적었더니
        //  아무것도 안 걸려 포괄 규칙으로 떨어졌다 — 문서함이 일반 직원에게 열려 있었다.
        'fileCabinetDocs', 'fileCabinetCategories', 'fileCabinetSubCategories',
        'users', 'partnerSignups'
      ];
    }

    //  전용 규칙이 따로 있는 컬렉션 — 포괄 규칙에서 **반드시 빼야 한다.**
    //  Firestore 는 여러 match 중 하나만 참이어도 허용하므로, 안 빼면 아래 제한이 무력화된다.
    function hasOwnRule(c) {
      return c in ['items','rawInventories','rawMaterialLedger','rawInventoryReversalGuards','rawManualCorrectionReceipts'] || c == 'workProjectsV1' || serverAuditCollection(c) || c in ['orderStatusAudits', 'orderStockFullAttemptsV1', 'orderProductionAssignmentsV1', 'rawMaterialLedger', 'rawInventoryReversalGuards', 'rawInventoryJobs', 'orderManualCorrectionsV1', 'rawManualCorrectionReceipts', 'palletTransactionOperations', 'partnerEditOperations', 'productionRecordOperations', 'workOrderItems', 'workOrderOperations', 'workOrderFences', 'noticeOperations', 'noticePhotoUploads', 'noticeStoragePaths', 'companyInfoOperations', 'fileCabinetCategories', 'fileCabinetSubCategories', 'documentCategoryOperations', 'documentCategoryFences', 'fileCabinetDocs', 'documentMetadataOperations', 'documentUploadReservations', 'documentStoragePaths', 'catalogItemMergeState', 'catalogOrderReferenceProofs', 'catalogItemMergeReceipts', 'helpChatUsage', 'orderCopyOperations', 'orderInterpretationRules', 'items', 'orders', 'purchaseOrders', 'inventoryWriterDeletions', 'statementIssueOperations', 'orderRequestRetirementAuthorizations', 'orderRequestRetirements', 'taxIssueRecords', 'returnRequests', 'issuedStatements', 'cashEntries', 'employees', 'authLoginAttempts', 'usernames', 'leaveRequestOperations', 'itemEditorOperations', 'employeeEditOperations', 'partnerItemTermsOperations', 'directoryDeleteOperations', 'quotationOperations', 'accountManagementOperations', 'orderEditOperations', 'orderItemEdits', 'leaveRequests', 'adjustmentRequests',
                   'chatRooms', 'chatMessages', 'notifications', 'notices', 'productionWorkDocuments', 'productionWorkDocumentLines', 'item_purchase_unit', 'partner_item', 'item_bom', 'item_pack'];
    }

    // 프로젝트 자료는 참여자 경계가 권한이다. 포괄 회사 규칙과 겹치지 않아야 한다.
    function projectEmployee() {
      let employee = get(/databases/$(database)/documents/employees/$(me()));
      return isEmployee() && canSee(employee.data.companyId)
        && employee.data.authUid == request.auth.uid && employee.data.get('status', '') != 'out';
    }
    function projectAdmin() {
      return projectEmployee() && request.auth.token.get('isAdmin', false) == true
        && get(/databases/$(database)/documents/employees/$(me())).data.get('adminAccess', false) == true;
    }
    function projectReadable(data) {
      return projectEmployee() && canSee(data.companyId) && (me() in data.participantIds || projectAdmin());
    }
    function projectActive(data) { return projectReadable(data) && data.status == 'active'; }
    function projectListBounded() { return request.query.limit != null && request.query.limit <= 50; }
    function projectCreateProof(projectId, data) {
      let opPath = /databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(data.lastOperationId);
      let op = getAfter(opPath).data;
      let r = op.request;
      return projectEmployee() && !exists(opPath)
        && op.keys().hasOnly(['version','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','request','status','before','after','at'])
        && op.keys().hasAll(['version','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','request','status','before','after','at'])
        && op.version == 1 && op.operationId == data.lastOperationId && op.projectEpoch == data.epoch
        && op.actorUid == request.auth.uid && op.actorEmployeeId == me() && op.action == 'project.create'
        && op.before == null && op.after == data && op.at == request.time
        && ((op.status == 'applied' && data.status == 'active') || (op.status == 'cancelled' && data.status == 'deleted'))
        && r.keys().hasOnly(['version','companyId','projectId','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','expectedProjectRevision','expectedTargetRevision','input'])
        && r.keys().hasAll(['version','companyId','projectId','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','expectedProjectRevision','expectedTargetRevision','input'])
        && r.version == 1 && r.companyId == myCompany() && r.projectId == projectId && r.projectEpoch == data.epoch
        && r.operationId == op.operationId && r.actorUid == request.auth.uid && r.actorEmployeeId == me() && r.action == op.action
        && r.target == op.target && r.target == {'kind':'project','id':projectId}
        && r.expectedProjectRevision == null && r.expectedTargetRevision == null
        && r.input.keys().hasOnly(['title','description']) && r.input.keys().hasAll(['title','description'])
        && r.input.title is string && r.input.title.size() > 0 && r.input.title.size() <= 120
        && r.input.description is string && r.input.description.size() <= 10000
        && data.keys().hasOnly(['version','companyId','epoch','ownerEmployeeId','participantIds','title','description','revision','status','lastOperationId','createdAt','updatedAt'])
        && data.keys().hasAll(['version','companyId','epoch','ownerEmployeeId','participantIds','title','description','revision','status','lastOperationId','createdAt','updatedAt'])
        && data.version == 1 && data.companyId == myCompany() && data.epoch is string && data.epoch.size() > 0
        && data.ownerEmployeeId == me() && data.participantIds == [me()] && data.title == r.input.title && data.description == r.input.description
        && data.revision == 1 && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function projectRequestOk(r, projectId, operationId) {
      return r.keys().hasOnly(['version','companyId','projectId','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','expectedProjectRevision','expectedTargetRevision','input'])
        && r.keys().hasAll(['version','companyId','projectId','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','expectedProjectRevision','expectedTargetRevision','input'])
        && r.version == 1 && r.companyId == myCompany() && r.projectId == projectId && r.operationId == operationId
        && r.actorUid == request.auth.uid && r.actorEmployeeId == me() && r.projectEpoch is string && r.projectEpoch.size() > 0
        && r.action in ['project.edit','project.delete','member.add','member.remove','task.create','task.edit','task.delete','checklist.create','checklist.edit','checklist.delete','comment.create','comment.edit','comment.delete']
        && r.input is map && r.target is map && r.target.id is string && r.target.id.size() > 0
        && ((r.action in ['project.edit','project.delete','member.add','member.remove'] && r.target == {'kind':'project','id':projectId})
          || (r.action in ['task.create','task.edit','task.delete'] && r.target.keys().hasOnly(['kind','id']) && r.target.kind == 'task')
          || (r.action in ['checklist.create','checklist.edit','checklist.delete','comment.create','comment.edit','comment.delete'] && r.target.keys().hasOnly(['kind','id','taskId']) && r.target.keys().hasAll(['kind','id','taskId']) && r.target.taskId is string && r.target.taskId.size() > 0 && ((r.action.matches('checklist[.].*') && r.target.kind == 'checklist') || (r.action.matches('comment[.].*') && r.target.kind == 'comment'))));
    }
    function projectTargetPath(projectId, target) {
      return target.kind == 'project' ? /databases/$(database)/documents/workProjectsV1/$(projectId)
        : target.kind == 'task' ? /databases/$(database)/documents/workProjectsV1/$(projectId)/tasks/$(target.id)
        : target.kind == 'checklist' ? /databases/$(database)/documents/workProjectsV1/$(projectId)/tasks/$(target.taskId)
        : /databases/$(database)/documents/workProjectsV1/$(projectId)/tasks/$(target.taskId)/comments/$(target.id);
    }
    function projectReceiptOk(op, projectId, operationId) {
      return op.keys().hasOnly(['version','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','request','status','before','after','at'])
        && op.keys().hasAll(['version','projectEpoch','operationId','actorUid','actorEmployeeId','action','target','request','status','before','after','at'])
        && op.version == 1 && op.operationId == operationId && op.actorUid == request.auth.uid && op.actorEmployeeId == me()
        && op.at == request.time && op.projectEpoch == op.request.projectEpoch && op.action == op.request.action && op.target == op.request.target
        && projectRequestOk(op.request, projectId, operationId);
    }
    function projectTags(tags) {
      let p = tags.concat(['','','','','','','','','','','','','','','','','','','','']);
      return tags is list && tags.size() <= 20 && !tags.hasAny([''])
        && p[0] is string && p[0].size() <= 40
        && p[1] is string && p[1].size() <= 40
        && p[2] is string && p[2].size() <= 40
        && p[3] is string && p[3].size() <= 40
        && p[4] is string && p[4].size() <= 40
        && p[5] is string && p[5].size() <= 40
        && p[6] is string && p[6].size() <= 40
        && p[7] is string && p[7].size() <= 40
        && p[8] is string && p[8].size() <= 40
        && p[9] is string && p[9].size() <= 40
        && p[10] is string && p[10].size() <= 40
        && p[11] is string && p[11].size() <= 40
        && p[12] is string && p[12].size() <= 40
        && p[13] is string && p[13].size() <= 40
        && p[14] is string && p[14].size() <= 40
        && p[15] is string && p[15].size() <= 40
        && p[16] is string && p[16].size() <= 40
        && p[17] is string && p[17].size() <= 40
        && p[18] is string && p[18].size() <= 40
        && p[19] is string && p[19].size() <= 40;
    }
    function projectDay(value) {
      return value == null || (value is string && (value.matches('[0-9]{4}-(0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])')
        || value.matches('[0-9]{4}-(0[469]|11)-(0[1-9]|[12][0-9]|30)')
        || value.matches('[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])')
        || value.matches('([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29')));
    }
    function projectTaskInput(input, parent, before) {
      return input.keys().hasOnly(['title','description','status','assigneeEmployeeId','startDate','endDate','priority','tags'])
        && input.keys().hasAll(['title','description','status','assigneeEmployeeId','startDate','endDate','priority','tags'])
        && input.title is string && input.title.size() > 0 && input.title.size() <= 200 && input.description is string && input.description.size() <= 20000
        && input.status in ['todo','doing','review','done'] && input.priority in ['low','normal','high'] && projectTags(input.tags)
        && (input.assigneeEmployeeId == null || (input.assigneeEmployeeId is string && (input.assigneeEmployeeId in parent.participantIds || (before != null && input.assigneeEmployeeId == before.assigneeEmployeeId))))
        && projectDay(input.startDate) && projectDay(input.endDate) && (input.startDate == null || input.endDate == null || input.startDate <= input.endDate);
    }
    function projectTaskFields(after, input) {
      return after.title == input.title && after.description == input.description && after.status == input.status
        && after.assigneeEmployeeId == input.assigneeEmployeeId && after.startDate == input.startDate && after.endDate == input.endDate
        && after.priority == input.priority && after.tags == input.tags;
    }
    function projectManager(parent) { return parent.ownerEmployeeId == me() || projectAdmin(); }
    function projectTargetTransition(projectId, op, parent, before, after) {
      let r = op.request;
      let a = r.action;
      let input = r.input;
      return (a in ['project.edit','project.delete','member.add','member.remove'] && before == parent && after.revision == before.revision + 1 && r.expectedTargetRevision == before.revision
          && ((a == 'project.edit' && input.keys().hasOnly(['title','description']) && input.keys().hasAll(['title','description']) && input.title is string && input.title.size() > 0 && input.title.size() <= 120 && input.description is string && input.description.size() <= 10000 && after.title == input.title && after.description == input.description && after.diff(before).affectedKeys().hasOnly(['title','description','revision','lastOperationId','updatedAt']))
           || (a == 'project.delete' && projectManager(parent) && input.keys().size() == 0 && after.status == 'deleted' && after.diff(before).affectedKeys().hasOnly(['status','revision','lastOperationId','updatedAt']))
           || (a in ['member.add','member.remove'] && projectManager(parent) && input.keys().hasOnly(['employeeId']) && input.keys().hasAll(['employeeId']) && input.employeeId is string && after.diff(before).affectedKeys().hasOnly(['participantIds','revision','lastOperationId','updatedAt']) && after.participantIds is list && after.participantIds.size() <= 50 && after.participantIds.toSet().size() == after.participantIds.size()
             && ((a == 'member.add' && !(input.employeeId in before.participantIds) && after.participantIds.toSet().difference(before.participantIds.toSet()) == [input.employeeId].toSet() && before.participantIds.toSet().difference(after.participantIds.toSet()).size() == 0 && get(/databases/$(database)/documents/employees/$(input.employeeId)).data.companyId == parent.companyId && get(/databases/$(database)/documents/employees/$(input.employeeId)).data.get('status','') != 'out')
               || (a == 'member.remove' && input.employeeId != before.ownerEmployeeId && before.participantIds.toSet().difference(after.participantIds.toSet()) == [input.employeeId].toSet() && after.participantIds.toSet().difference(before.participantIds.toSet()).size() == 0)))))
        || (a == 'task.create' && before == null && r.expectedTargetRevision == null && projectTaskInput(input,parent,null)
          && after.keys().hasOnly(['version','projectEpoch','title','description','status','assigneeEmployeeId','startDate','endDate','priority','tags','checklist','revision','deletedAt','lastOperationId','createdAt','updatedAt'])
          && after.keys().hasAll(['version','projectEpoch','title','description','status','assigneeEmployeeId','startDate','endDate','priority','tags','checklist','revision','deletedAt','lastOperationId','createdAt','updatedAt'])
          && after.version == 1 && after.projectEpoch == parent.epoch && projectTaskFields(after,input) && after.checklist == {} && after.revision == 1 && after.deletedAt == null && after.lastOperationId == op.operationId && after.createdAt == request.time && after.updatedAt == request.time)
        || (a in ['task.edit','task.delete','checklist.create','checklist.edit','checklist.delete'] && before != null && before.projectEpoch == parent.epoch && before.deletedAt == null && r.expectedTargetRevision == before.revision && after.revision == before.revision + 1 && after.lastOperationId == op.operationId && after.updatedAt == request.time
          && ((a == 'task.edit' && projectTaskInput(input,parent,before) && projectTaskFields(after,input) && after.diff(before).affectedKeys().hasOnly(['title','description','status','assigneeEmployeeId','startDate','endDate','priority','tags','revision','lastOperationId','updatedAt']))
           || (a == 'task.delete' && input.keys().size() == 0 && after.deletedAt == request.time && after.diff(before).affectedKeys().hasOnly(['deletedAt','revision','lastOperationId','updatedAt']))
           || (a in ['checklist.create','checklist.edit','checklist.delete'] && before.checklist is map && after.checklist is map && after.checklist.size() <= 50 && after.checklist.diff(before.checklist).affectedKeys() == [r.target.id].toSet() && after.diff(before).affectedKeys().hasOnly(['checklist','revision','lastOperationId','updatedAt'])
             && ((a == 'checklist.delete' && input.keys().size() == 0 && r.target.id in before.checklist && !(r.target.id in after.checklist))
               || (a in ['checklist.create','checklist.edit'] && input.keys().hasOnly(['title','checked']) && input.keys().hasAll(['title','checked']) && input.title is string && input.title.size() > 0 && input.title.size() <= 500 && input.checked is bool && after.checklist[r.target.id] == input && ((a == 'checklist.create' && !(r.target.id in before.checklist)) || (a == 'checklist.edit' && r.target.id in before.checklist)))))))
        || (a == 'comment.create' && before == null && r.expectedTargetRevision == null && input.keys().hasOnly(['body']) && input.keys().hasAll(['body']) && input.body is string && input.body.size() > 0 && input.body.size() <= 5000
          && after.keys().hasOnly(['version','projectEpoch','taskId','authorEmployeeId','body','revision','deletedAt','lastOperationId','createdAt','updatedAt']) && after.keys().hasAll(['version','projectEpoch','taskId','authorEmployeeId','body','revision','deletedAt','lastOperationId','createdAt','updatedAt'])
          && after.version == 1 && after.projectEpoch == parent.epoch && after.taskId == r.target.taskId && after.authorEmployeeId == me() && after.body == input.body && after.revision == 1 && after.deletedAt == null && after.lastOperationId == op.operationId && after.createdAt == request.time && after.updatedAt == request.time)
        || (a in ['comment.edit','comment.delete'] && before != null && before.projectEpoch == parent.epoch && before.taskId == r.target.taskId && before.deletedAt == null && r.expectedTargetRevision == before.revision && (before.authorEmployeeId == me() || projectManager(parent)) && after.revision == before.revision + 1 && after.lastOperationId == op.operationId && after.updatedAt == request.time
          && ((a == 'comment.edit' && input.keys().hasOnly(['body']) && input.keys().hasAll(['body']) && input.body is string && input.body.size() > 0 && input.body.size() <= 5000 && after.body == input.body && after.diff(before).affectedKeys().hasOnly(['body','revision','lastOperationId','updatedAt']))
           || (a == 'comment.delete' && input.keys().size() == 0 && after.deletedAt == request.time && after.diff(before).affectedKeys().hasOnly(['deletedAt','revision','lastOperationId','updatedAt']))));
    }
    function projectNormalProof(projectId, operationId) {
      let projectPath = /databases/$(database)/documents/workProjectsV1/$(projectId);
      let opPath = /databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(operationId);
      let op = getAfter(opPath).data;
      let r = op.request;
      let targetPath = projectTargetPath(projectId, r.target);
      let parent = get(projectPath).data;
      let nextParent = getAfter(projectPath).data;
      let before = exists(targetPath) ? get(targetPath).data : null;
      let after = existsAfter(targetPath) ? getAfter(targetPath).data : null;
      return !exists(opPath) && projectReceiptOk(op,projectId,operationId)
        && projectActive(parent) && canSee(nextParent.companyId) && (me() in nextParent.participantIds || projectAdmin()) && parent.epoch == r.projectEpoch
        && op.status == 'applied' && op.before == before && op.after == after && after != null
        && after.lastOperationId == operationId
        && ((before == null && r.expectedTargetRevision == null && after.revision == 1)
          || (before != null && r.expectedTargetRevision == before.revision && after.revision == before.revision + 1))
        && r.expectedProjectRevision == parent.revision && nextParent.revision == parent.revision + 1
        && nextParent.lastOperationId == operationId && nextParent.updatedAt == request.time
        && (r.target.kind == 'project' || (nextParent.status == 'active' && nextParent.diff(parent).affectedKeys().hasOnly(['revision','lastOperationId','updatedAt'])))
        && (r.target.kind != 'comment' || (get(/databases/$(database)/documents/workProjectsV1/$(projectId)/tasks/$(r.target.taskId)).data.projectEpoch == parent.epoch
          && get(/databases/$(database)/documents/workProjectsV1/$(projectId)/tasks/$(r.target.taskId)).data.deletedAt == null
          && get(/databases/$(database)/documents/workProjectsV1/$(projectId)/tasks/$(r.target.taskId)).data == getAfter(/databases/$(database)/documents/workProjectsV1/$(projectId)/tasks/$(r.target.taskId)).data));
    }
    function projectParentProof(projectId, operationId) {
      let path = /databases/$(database)/documents/workProjectsV1/$(projectId);
      let opPath = /databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(operationId);
      let op = getAfter(opPath).data;
      let before = resource.data;
      let after = request.resource.data;
      return !exists(opPath) && op.status == 'applied' && op.operationId == operationId
        && ((op.target.kind == 'project' && op.before == before && op.after == after && projectTargetTransition(projectId,op,before,before,after))
          || (op.target.kind != 'project' && after.status == 'active' && after.diff(before).affectedKeys().hasOnly(['revision','lastOperationId','updatedAt'])))
        && getAfter(path).data == after;
    }
    function projectChildProof(projectId, operationId) {
      let opPath = /databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(operationId);
      let op = getAfter(opPath).data;
      let parent = get(/databases/$(database)/documents/workProjectsV1/$(projectId)).data;
      let before = resource == null ? null : resource.data;
      return !exists(opPath) && op.status == 'applied' && op.operationId == operationId
        && op.before == before && op.after == request.resource.data
        && projectTargetTransition(projectId,op,parent,before,request.resource.data);
    }
    function projectCancelProof(projectId, operationId, op) {
      let projectPath = /databases/$(database)/documents/workProjectsV1/$(projectId);
      let targetPath = projectTargetPath(projectId,op.request.target);
      let parent = get(projectPath).data;
      let before = exists(targetPath) ? get(targetPath).data : null;
      let after = existsAfter(targetPath) ? getAfter(targetPath).data : null;
      return projectEmployee() && projectReceiptOk(op,projectId,operationId) && op.status == 'cancelled'
        && projectActive(parent) && parent.epoch == op.request.projectEpoch && getAfter(projectPath).data == parent
        && op.before == before && op.after == before && after == before;
    }
    match /workProjectsV1/{projectId} {
      allow get: if projectEmployee() && (resource == null || projectReadable(resource.data));
      allow list: if projectListBounded() && projectReadable(resource.data);
      allow create: if !exists(/databases/$(database)/documents/workProjectsV1/$(projectId)) && projectCreateProof(projectId, request.resource.data);
      allow update: if projectParentProof(projectId,request.resource.data.lastOperationId);
      allow delete: if false;
      match /tasks/{taskId} {
        allow get: if projectActive(get(/databases/$(database)/documents/workProjectsV1/$(projectId)).data);
        allow list: if projectListBounded() && projectActive(get(/databases/$(database)/documents/workProjectsV1/$(projectId)).data);
        allow create, update: if projectChildProof(projectId,request.resource.data.lastOperationId)
          && getAfter(/databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(request.resource.data.lastOperationId)).data.target.kind in ['task','checklist']
          && (getAfter(/databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(request.resource.data.lastOperationId)).data.target.kind == 'task'
              ? getAfter(/databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(request.resource.data.lastOperationId)).data.target.id == taskId
              : getAfter(/databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(request.resource.data.lastOperationId)).data.target.taskId == taskId);
        allow delete: if false;
        match /comments/{commentId} {
          allow get: if projectActive(get(/databases/$(database)/documents/workProjectsV1/$(projectId)).data);
          allow list: if projectListBounded() && projectActive(get(/databases/$(database)/documents/workProjectsV1/$(projectId)).data);
          allow create, update: if projectChildProof(projectId,request.resource.data.lastOperationId)
            && getAfter(/databases/$(database)/documents/workProjectsV1/$(projectId)/operations/$(request.resource.data.lastOperationId)).data.target == {'kind':'comment','id':commentId,'taskId':taskId};
          allow delete: if false;
        }
      }
      match /operations/{operationId} {
        allow get: if projectEmployee() && ((!exists(/databases/$(database)/documents/workProjectsV1/$(projectId)) && resource == null) || projectReadable(get(/databases/$(database)/documents/workProjectsV1/$(projectId)).data));
        allow list: if projectListBounded() && projectReadable(get(/databases/$(database)/documents/workProjectsV1/$(projectId)).data);
        allow create: if request.resource.data.operationId == operationId && ((!exists(/databases/$(database)/documents/workProjectsV1/$(projectId))
          && getAfter(/databases/$(database)/documents/workProjectsV1/$(projectId)).data == request.resource.data.after
          && projectCreateProof(projectId, request.resource.data.after))
          || (exists(/databases/$(database)/documents/workProjectsV1/$(projectId))
            && ((request.resource.data.status == 'applied' && projectNormalProof(projectId,operationId))
              || (request.resource.data.status == 'cancelled' && projectCancelProof(projectId,operationId,request.resource.data)))));
        allow update, delete: if false;
      }
    }

    // 미반영·요청 폐기 근거는 서버만 판독한다. 관리자 조회도 열면 최초 원문이 노출된다.
    // 명시 거절만으로 포괄 허용을 이길 수 없으므로 위 hasOwnRule에서도 제외한다.
    // 최초 주문 원문과 규칙 승인은 RPC에서 회사·직원·관리자 권한을 확인한다.
    match /orderStockFullAttemptsV1/{document=**} { allow read, write: if false; }
    match /orderProductionAssignmentsV1/{document=**} { allow read, write: if false; }
    match /orderManualCorrectionsV1/{document=**} { allow read, write: if false; }
    match /orderStatusAudits/{id} {
      allow get: if getOk();
      allow list: if readOk();
      allow create, update: if !id.matches('full-request-cancel:.*') && createUpdateOk()
        && inventoryQuantityOk('orderStatusAudits') && rawWriterOk('orderStatusAudits')
        && fullEffectWriteOk('orderStatusAudits') && oemCostFieldsOk('orderStatusAudits')
        && payrollWriteAllowed('orderStatusAudits');
      allow delete: if !id.matches('full-request-cancel:.*') && deleteOk()
        && !rawWriterCollection('orderStatusAudits') && fullEffectWriteOk('orderStatusAudits')
        && payrollWriteAllowed('orderStatusAudits');
    }
    match /rawManualCorrectionReceipts/{id} {
      allow get: if isEmployee() && resource != null && resource.data.get('version', 0) == 3
        && permitActorOk(resource.data);
      allow update: if isEmployee() && resource.data.get('version', 0) == 3
        && resource.data.get('kind', '') == 'raw-reverse-group' && permitActorOk(resource.data)
        && resource.data.get('state', '') == 'prepared' && request.resource.data.get('state', '') == 'applied'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
        && permitAllEffects(resource.data) && permitBusinessEffect(resource.data);
      allow list, create, delete: if false;
    }
    match /palletTransactionOperations/{document=**} { allow read, write: if false; }
    match /noticeOperations/{document=**} { allow read, write: if false; }
    match /noticePhotoUploads/{document=**} { allow read, write: if false; }
    match /noticeStoragePaths/{document=**} { allow read, write: if false; }
    match /workOrderItems/{id} {
      allow get: if isEmployee() && getOk();
      allow list: if isEmployee() && readOk();
    }
    match /partnerEditOperations/{document=**} { allow read, write: if false; }
    match /productionRecordOperations/{document=**} { allow read, write: if false; }
    match /workOrderOperations/{document=**} { allow read, write: if false; }
    match /workOrderFences/{document=**} { allow read, write: if false; }
    function workOrderProtectedPath() {
      return request.path == /databases/$(database)/documents/settings/taebaek__workGroups
        || request.path == /databases/$(database)/documents/settings/punghoe__workGroups
        || request.path == /databases/$(database)/documents/appMeta/workOrderReset_taebaek
        || request.path == /databases/$(database)/documents/appMeta/workOrderReset_punghoe;
    }
    match /companyInfoOperations/{document=**} {
      allow read, write: if false;
    }
    match /helpChatUsage/{document=**} {
      allow get, list, create, update, delete: if false;
    }
    match /orderCopyOperations/{document=**} {
      allow read, write: if false;
    }
    match /orderInterpretationRules/{document=**} {
      allow read, write: if false;
    }
    match /statementIssueOperations/{document=**} {
      allow get, list, create, update, delete: if false;
    }
    match /orderRequestRetirementAuthorizations/{document=**} {
      allow get, list, create, update, delete: if false;
    }
    match /orderRequestRetirements/{document=**} {
      allow get, list, create, update, delete: if false;
    }

    // 매입 단위는 별도 등록표다. 직원은 회사 안에서 선택하고 관리자만 표를 수정한다.
    function purchaseUnitCatalogOk(id) {
      let data = request.resource.data;
      let item = getAfter(/databases/$(database)/documents/items/$(data.itemId)).data;
      return data.keys().hasOnly(['id', 'companyId', 'itemId', 'partnerId', 'purchaseUnit', 'unitKg', 'isDefault', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'companyId', 'itemId', 'purchaseUnit', 'unitKg', 'isDefault', 'active', 'createdAt', 'updatedAt'])
        && data.id == id && data.itemId is string && data.itemId.size() > 0
        && data.purchaseUnit is string && data.purchaseUnit.size() > 0
        && data.unitKg is number && data.unitKg > 0 && data.unitKg - data.unitKg == 0
        && data.isDefault is bool && data.active is bool
        && data.createdAt is string && data.updatedAt is string
        && item.companyId == data.companyId && item.subtype == '벌크'
        && (!('phantom' in item) || item.phantom == false)
        && (!('archived' in item) || item.archived == false)
        && (!('partnerId' in data) || (data.partnerId is string && data.partnerId.size() > 0
          && get(/databases/$(database)/documents/partners/$(data.partnerId)).data.companyId == data.companyId));
    }
    match /item_purchase_unit/{id} {
      allow get: if getOk();
      allow list: if readOk();
      allow create: if isAdmin() && createUpdateOk() && purchaseUnitCatalogOk(id);
      allow update: if isAdmin() && createUpdateOk() && purchaseUnitCatalogOk(id)
        && request.resource.data.id == resource.data.id
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() && deleteOk();
    }
    function catalogLiveItemAfter(id, company) {
      let path = /databases/$(database)/documents/items/$(id);
      return existsAfter(path) && getAfter(path).data.get('companyId', 'taebaek') == company;
    }
    function catalogChangedReferenceOk(before, next, field) {
      return resource != null && before.get(field, null) == next.get(field, null)
        || (next.get(field, null) is string && next.get(field, '').size() > 0
          && catalogLiveItemAfter(next[field], next.companyId));
    }
    function catalogLinkReferencesOk(c) {
      let before = resource == null ? {} : resource.data;
      let next = request.resource.data;
      let epoch = /databases/$(database)/documents/catalogItemMergeState/$(next.companyId);
      return !existsAfter(epoch)
        || (c == 'partner_item' && catalogChangedReferenceOk(before, next, 'itemId'))
        || (c == 'item_pack' && catalogChangedReferenceOk(before, next, 'item_id'))
        || (c == 'item_bom' && catalogChangedReferenceOk(before, next, 'parent_id') && catalogChangedReferenceOk(before, next, 'child_id'));
    }
    match /{catalogCollection}/{id} {
      allow get: if catalogCollection in ['partner_item', 'item_bom', 'item_pack'] && isEmployee() && getOk();
      allow list: if catalogCollection in ['partner_item', 'item_bom', 'item_pack'] && isEmployee() && readOk();
      allow create, update: if catalogCollection in ['partner_item', 'item_bom', 'item_pack'] && isEmployee()
        && createUpdateOk() && catalogLinkReferencesOk(catalogCollection);
      allow delete: if catalogCollection in ['partner_item', 'item_bom', 'item_pack'] && isEmployee() && deleteOk();
    }
    // 현금 내역은 서버 원자 명령만 저장한다. 기존 회사별 관리자 조회는 유지한다.
    match /cashEntries/{id} {
      allow get: if isAdmin() && getOk();
      allow list: if isAdmin() && readOk();
    }

    // 기초 전표를 포함한 전표 저장은 서버 명령만 수행한다.
    match /issuedStatements/{id} {
      allow get: if isAdmin() && getOk();
      allow list: if isAdmin() && readOk();
    }

    // 서류 발행 기록과 원전표 완료 metadata는 같은 서버 명령만 저장한다.
    match /taxIssueRecords/{id} {
      allow get: if isAdmin() && getOk();
      allow list: if isAdmin() && readOk();
    }

    // 반품 접수·수량 수정·처리는 서버 명령이 저장한다. 현장 직원 조회는 유지한다.
    match /returnRequests/{id} {
      allow get: if isEmployee() && getOk();
      allow list: if isEmployee() && readOk();
    }

    // 정산 명령·운영 보상 감사는 서버가 기록한다. 같은 회사 관리자만 읽을 수 있다.
    match /{collection}/{id} {
      allow get: if serverAuditCollection(collection) && isAdmin() && getOk();
      allow list: if serverAuditCollection(collection) && isAdmin() && readOk();
    }

    function productionParentAdvanced(parentId) {
      let path = /databases/$(database)/documents/productionWorkDocuments/$(parentId);
      let after = getAfter(path).data;
      return canSee(after.companyId)
        && after.revision == (exists(path) ? get(path).data.revision : 0) + 1;
    }
    match /productionWorkDocuments/{id} {
      allow get: if getOk();
      allow list: if readOk();
      allow create, update: if createUpdateOk()
        && request.resource.data.id == id
        && request.resource.data.documentDate is string
        && request.resource.data.documentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == myCompany() + '__production-work__' + request.resource.data.documentDate
        && request.resource.data.templateVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.rowCount is int
        && request.resource.data.rowCount >= 0 && request.resource.data.rowCount <= 200
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.specialNotes is string
        && request.resource.data.preparedByName is string
        && request.resource.data.reviewedByName is string
        && request.resource.data.approvedByName is string
        && (resource == null
          ? request.resource.data.createdBy == request.auth.uid
          : request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.documentDate == resource.data.documentDate);
      allow delete: if false;
    }
    match /productionWorkDocumentLines/{id} {
      allow get: if getOk();
      allow list: if readOk();
      allow create, update: if createUpdateOk()
        && request.resource.data.id == id
        && request.resource.data.documentId is string
        && id.matches('^' + request.resource.data.documentId + '__.*')
        && (resource == null || resource.data.documentId == request.resource.data.documentId)
        && productionParentAdvanced(request.resource.data.documentId)
        && request.resource.data.documentRevision == getAfter(/databases/$(database)/documents/productionWorkDocuments/$(request.resource.data.documentId)).data.revision
        && request.resource.data.batchKey is string && request.resource.data.batchKey.size() > 0
        && request.resource.data.sortOrder is int && request.resource.data.sortOrder >= 0
        && request.resource.data.sourceState in ['active', 'missing', 'reversed']
        && request.resource.data.source is map
        && request.resource.data.source.kind in ['production', 'raw-usage', 'manual']
        && request.resource.data.manualFields is map
        && request.resource.data.sourceSnapshot is map
        && (request.resource.data.productionQty == null || (request.resource.data.productionQty is number && request.resource.data.productionQty >= 0))
        && (request.resource.data.rawUsedKg == null || (request.resource.data.rawUsedKg is number && request.resource.data.rawUsedKg >= 0));
      allow delete: if deleteOk() && productionParentAdvanced(resource.data.documentId);
    }


    //  다른 문서를 읽어 견주는 자리가 셋 있다(오피스톡 방·메시지·알림).
    //  `get()`·`exists()` 는 규칙 한 번에 **10회까지**라 그 한도가 방 인원 제한의 까닭이다.

    // ── 아이디 매핑 — 로그인 전에도 한 건은 봐야 한다 ───────────────
    //  거래처 홈페이지 회원가입 중복확인·로그인이 미인증 상태에서 단일 문서를 조회한다.
    //  `list` 는 막는다 — 전체 아이디를 훑어 가는 것을 막기 위해서다.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    //  로그인 시도 기록 — 서버(Functions)만 쓴다. 클라이언트는 아무것도 못 한다.
    match /authLoginAttempts/{attemptId} {
      allow read, write: if false;
    }

    // ── 직원 ───────────────────────────────────────────────────
    //  **같은 회사 직원만 서로 본다.** 로그인 화면이 목록을 훑던 구조는 Callable 로 옮겼다.
    //  본인은 **푸시 표만** 고칠 수 있다 — 권한·급여를 스스로 못 바꾸게.
    match /employees/{employeeId} {
      allow read: if readOk();
      allow create: if isAdmin() && canSee(request.resource.data.companyId);
      // 퇴직금 장부가 생긴 직원은 삭제 대신 퇴사 상태로 보존한다.
      allow delete: if isAdmin() && deleteOk()
                    && !exists(/databases/$(database)/documents/retirementProfiles/$(myCompany() + '__' + employeeId));
      allow update: if (isAdmin() && createUpdateOk())
                    || (isEmployee()
                        && me() == employeeId
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['fcmTokens', 'fcmDevices']));
    }

    // ── 연차 — 본인이 내고, 관리자가 결재한다 ────────────────────
    match /orderEditOperations/{document=**} {
      allow read, write: if false;
    }
    match /itemEditorOperations/{document=**} {
      allow read, write: if false;
    }
    match /employeeEditOperations/{document=**} {
      allow read, write: if false;
    }
    match /partnerItemTermsOperations/{document=**} {
      allow read, write: if false;
    }
    match /directoryDeleteOperations/{document=**} {
      allow read, write: if false;
    }
    match /accountManagementOperations/{document=**} {
      allow read, write: if false;
    }
    match /fileCabinetCategories/{document} {
      allow get, list: if isAdmin() && resource.data.companyId == request.auth.token.companyId;
      allow write: if false;
    }
    match /fileCabinetSubCategories/{document} {
      allow get, list: if isAdmin() && resource.data.companyId == request.auth.token.companyId;
      allow write: if false;
    }
    match /documentCategoryOperations/{document=**} { allow read, write: if false; }
    match /documentCategoryFences/{document=**} { allow read, write: if false; }
    match /fileCabinetDocs/{document} {
      allow get, list: if isAdmin() && resource.data.companyId == request.auth.token.companyId;
      allow write: if false;
    }
    match /documentMetadataOperations/{document=**} { allow read, write: if false; }
    match /documentUploadReservations/{document=**} { allow read, write: if false; }
    match /documentStoragePaths/{document=**} { allow read, write: if false; }
    match /quotationOperations/{document=**} {
      allow read, write: if false;
    }
    match /orderItemEdits/{id} {
      allow get: if getOk();
      allow list: if readOk();
      // 새 결정적 감사는 주문 수정과 같은 서버 거래에서만 만든다. 옛 이력 정책은 보존한다.
      allow create, update: if !id.matches('order-edit-.+') && createUpdateOk();
      allow delete: if !id.matches('order-edit-.+') && deleteOk();
    }
    match /leaveRequestOperations/{document=**} {
      allow read, write: if false;
    }
    match /leaveRequests/{id} {
      allow read: if readOk();
      // 직원 신청에 결재·미차감 값을 섞지 못하고, 관리자는 같은 회사 실직원에게 단체휴가를 부여한다.
      allow create: if isEmployee() && canSee(request.resource.data.companyId)
                    && ((isAdmin()
                         && request.resource.data.employeeId is string
                         && exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeId))
                         && get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.companyId == myCompany()
                         && request.resource.data.status in ['pending', 'approved'])
                        || (!isAdmin()
                            && request.resource.data.employeeId == me()
                            && request.resource.data.status == 'pending'
                            && request.resource.data.keys().hasOnly(['id', 'companyId', 'employeeId', 'employeeName',
                                'type', 'startDate', 'endDate', 'reason', 'status', 'requestedAt', 'daysUsed'])));
      // 실제 상태 변경은 원문 CAS와 영수증을 함께 쓰는 서버 명령만 통과한다.
      allow update: if false;
      allow delete: if (isAdmin() && deleteOk())
                            || (isEmployee()
                                && resource.data.employeeId == me()
                                && canSee(resource.data.companyId)
                                && resource.data.status == 'pending');
    }

    // ── 재고 조정 요청 — 직원이 올리고, 관리자가 처리한다 ──────────
    match /adjustmentRequests/{id} {
      allow read: if readOk();
      // OEM 취소는 아직 생성되지 않은 가공비 요청의 부재를 관리자 단건 조회로 확인한다.
      allow get: if isAdmin() && id.matches('OEMFEE-.+') && getOk();
      allow create: if isEmployee() && canSee(request.resource.data.companyId);
      /**
       * 처리(승인·반려)는 관리자만. 직원은 아직 처리 안 된 요청의 **내용만** 고친다.
       * 연차와 같은 까닭으로 칸을 못 박는다(코덱스 검수 4번) — 요청자·회사는 불변이고
       * 처리 칸(`processedBy`)은 직원이 못 건드린다.
       */
      allow update: if (isAdmin() && createUpdateOk())
                    || (isEmployee()
                        && canSee(resource.data.companyId)
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'pending'
                        && request.resource.data.companyId == resource.data.companyId
                        && request.resource.data.requestedBy == resource.data.requestedBy
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['qty', 'quantity', 'reason', 'note', 'type', 'updatedAt']));
      allow delete: if isAdmin() && deleteOk();
    }

    // ── 오피스톡 방 ────────────────────────────────────────────
    function validRoomParticipants() {
      let ids = request.resource.data.participantIds;
      let companies = request.resource.data.participantCompanies;
      return ids is list
             && ids.size() <= 30
             && companies is map
             && companies.keys().hasOnly(ids)
             && ids.hasOnly(companies.keys())
             && companies.values().hasOnly([request.resource.data.companyId]);
    }

    match /chatRooms/{roomId} {
      allow read: if readOk();
      allow create, update: if createUpdateOk()
                            && validRoomParticipants();
      allow delete: if deleteOk();
    }

    // ── 오피스톡 메시지 — 방을 따라간다 ──────────────────────────
    /**
     * **메시지 회사 = 방 회사.** 회사 검사만으로는 *풍회 방에 태백 메시지* 를 못 막는다.
     * 방을 직접 읽어 견준다. 없는 방에는 못 넣는다 — 방 없는 메시지는 아무도 못 읽는다.
     */
    match /chatMessages/{msgId} {
      allow read: if readOk();
      // 공유 최초 저장의 중복 확인만 허용한다. 기존 타회사 문서나 목록 조회에는 적용하지 않는다.
      allow get: if isEmployee() && myCompany() in ['taebaek', 'punghoe']
                 && msgId.matches('^MSG-share-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
                 && resource == null;
      allow create, update: if createUpdateOk()
                            && exists(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId))
                            && get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.companyId
                               == request.resource.data.companyId;
      allow delete: if deleteOk();
    }

    // ── 알림 — 개인 수신 또는 회사 전체 방송 ───────────────────
    /**
     * 실제 수신자 필드는 `targetId`다. 값이 없으면 같은 회사 전체 방송이다.
     * 개인 알림은 수신 직원의 회사와 알림 회사가 같아야 한다.
     */
    match /notifications/{nid} {
      // 고정 알림 번호의 첫 저장은 없는 문서를 먼저 읽는다. 목록과 기존 문서는 회사 경계를 유지한다.
      allow get: if getOk();
      allow list: if readOk();
      allow create: if createUpdateOk()
                    && (!('targetId' in request.resource.data)
                        || (request.resource.data.targetId is string
                            && exists(/databases/$(database)/documents/employees/$(request.resource.data.targetId))
                            && get(/databases/$(database)/documents/employees/$(request.resource.data.targetId)).data.companyId
                               == request.resource.data.companyId));
      // 알림 본문·수신자·회사는 만든 뒤 못 바꾼다. 확인 상태만 누적한다.
      allow update: if createUpdateOk()
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['readBy', 'dismissedBy']);
      allow delete: if deleteOk();
    }

    match /notices/{id} {
      allow read: if readOk();
      allow write: if false;
    }

    // 전환 문서는 회사 없는 서버 공통 설정이라 관리자 단건 조회만 예외로 연다.
    function isProtectedCutoverPath() {
      return request.path == /databases/$(database)/documents/appMeta/releaseCutover
        || request.path == /databases/$(database)/documents/appMeta/loanMovementCutover_taebaek
        || request.path == /databases/$(database)/documents/appMeta/loanMovementCutover_punghoe
        || request.path == /databases/$(database)/documents/appMeta/payrollIssueCutover_taebaek
        || request.path == /databases/$(database)/documents/appMeta/payrollIssueCutover_punghoe;
    }
    match /appMeta/releaseCutover {
      allow get: if isAdmin() && myCompany() in ['taebaek', 'punghoe'];
    }
    match /appMeta/{id} {
      allow get: if isAdmin() && id in ['loanMovementCutover_' + myCompany(), 'payrollIssueCutover_' + myCompany()];
    }
    function payrollWriteAllowed(c) {
      let gate = /databases/$(database)/documents/appMeta/$(('payrollIssueCutover_' + myCompany()));
      return c != 'payrolls'
        || !exists(gate)
        || get(gate).data.companyId != myCompany()
        || !(get(gate).data.firstYearMonth is string);
    }

    // 새 OEM 원가 근거는 발주 때 고정하고 확정 원가는 서버 거래만 저장한다.
    function oemCostFieldsOk(c) {
      return c != 'purchaseOrders'
        || (resource == null
          ? !request.resource.data.keys().hasAny(['oemBatchCost', 'oemCostEvidenceSource'])
          : request.resource.data.get('oemBatchCost', null) == resource.data.get('oemBatchCost', null)
            && request.resource.data.get('oemCostEvidence', null) == resource.data.get('oemCostEvidence', null)
            && request.resource.data.get('oemCostEvidenceSource', null) == resource.data.get('oemCostEvidenceSource', null)
            && (resource.data.get('oemBatchCost', null) == null
              || request.resource.data.get('linkedStatementId', null) == resource.data.get('linkedStatementId', null)
                && request.resource.data.get('linkedStatementAt', null) == resource.data.get('linkedStatementAt', null))
            && (resource.data.get('oemCostEvidence', null) == null
              || request.resource.data.get('oemIssueFingerprint', null) == resource.data.get('oemIssueFingerprint', null)
                && request.resource.data.get('oemSent', null) == resource.data.get('oemSent', null)));
    }
    // 새 앱은 최초 조회 버전을 한 번 증가시킨다. 주문을 읽지 않는 옛 품목 writer도 여기서 막는다.
    function writerRevision(data) {
      return data.get('inventoryWriteRevision', 0);
    }
    function writerBeforeOk(data) {
      return (!('inventoryWriterProtocolVersion' in data) || data.inventoryWriterProtocolVersion == 1)
        && (!('inventoryWriterProtocolVersion' in data) || 'inventoryWriteRevision' in data)
        && writerRevision(data) is int && writerRevision(data) >= 0 && writerRevision(data) < 9007199254740991;
    }
    function writerAdvanced(before, next, floor) {
      return writerBeforeOk(before) && next.get('inventoryWriterProtocolVersion', 0) == 1
        && next.get('inventoryWriteRevision', 0) is int
        && next.inventoryWriteRevision == floor + 1 && next.inventoryWriteRevision <= 9007199254740991;
    }
    function writerPreserved(before, next) {
      return next.get('inventoryWriterProtocolVersion', null) == before.get('inventoryWriterProtocolVersion', null)
        && next.get('inventoryWriteRevision', null) == before.get('inventoryWriteRevision', null);
    }
    function permitActorOk(p) {
      let employee = /databases/$(database)/documents/employees/$(me());
      return isEmployee() && p.get('actorUid', null) == request.auth.uid
        && p.get('employeeId', null) == me() && p.get('companyId', null) == myCompany()
        && get(employee).data.get('authUid', null) == request.auth.uid
        && get(employee).data.get('companyId', 'taebaek') == myCompany()
        && get(employee).data.get('status', '') != 'out'
        && get(employee).data.get('name', '') is string && get(employee).data.name.size() > 0;
    }
    function permitPath(id) { return /databases/$(database)/documents/rawManualCorrectionReceipts/$(id); }
    function permitEffectPath(e) { return /databases/$(database)/documents/$(e.collection)/$(e.id); }
    function permitEffectOk(e) {
      let path = permitEffectPath(e);
      return (e.beforeExists ? get(path).data == e.before : !exists(path) && e.before == null)
        && getAfter(path).data == e.after;
    }
    function permitAllEffects(p) {
      let a = p.get('rawEffects', []);
      return a is list && a.size() >= 1 && a.size() <= 8
        && permitEffectOk(a[0]) && (a.size() < 2 || permitEffectOk(a[1]))
        && (a.size() < 3 || permitEffectOk(a[2])) && (a.size() < 4 || permitEffectOk(a[3]))
        && (a.size() < 5 || permitEffectOk(a[4])) && (a.size() < 6 || permitEffectOk(a[5]))
        && (a.size() < 7 || permitEffectOk(a[6])) && (a.size() < 8 || permitEffectOk(a[7]));
    }
    function permitBusinessEffect(p) {
      let b = p.get('businessWitness', {});
      let path = permitEffectPath(b);
      return get(path).data == b.before
        && (b.afterExists ? getAfter(path).data == b.after : !existsAfter(path) && b.after == null);
    }
    function permitMarkerValid(value) {
      return value is map && value.keys().hasOnly(['permitId','slot']) && value.keys().hasAll(['permitId','slot'])
        && value.permitId is string && value.permitId.matches('^[a-f0-9]{64}$')
        && value.slot is int && value.slot >= 0 && value.slot < 8;
    }
    function permitMarkerPreserved(before, next) {
      return (('rawReversePermitRefV1' in before) == ('rawReversePermitRefV1' in next))
        && (!('rawReversePermitRefV1' in before) || (permitMarkerValid(before.rawReversePermitRefV1)
          && before.rawReversePermitRefV1 == next.rawReversePermitRefV1));
    }
    function permitRawTarget(c, id) {
      let marker = request.resource.data.get('rawReversePermitRefV1', {});
      let pid = marker is map ? marker.get('permitId', '') : '';
      let path = permitPath(pid is string && pid.size() > 0 ? pid : '__invalid__');
      let p = get(path).data;
      let slot = marker is map ? marker.get('slot', -1) : -1;
      let effects = p.get('rawEffects', []);
      return p.get('version', 0) == 3 && p.get('kind', '') == 'raw-reverse-group'
        && p.actorUid == request.auth.uid && p.employeeId == me() && p.companyId == myCompany()
        && p.get('state', '') == 'prepared' && getAfter(path).data.get('state', '') == 'applied'
        && getAfter(path).data.diff(p).affectedKeys().hasOnly(['state'])
        && effects is list && slot < effects.size() && effects[slot].collection == c && effects[slot].id == id
        && (effects[slot].beforeExists ? resource != null && resource.data == effects[slot].before : resource == null && effects[slot].before == null)
        && request.resource.data == effects[slot].after;
    }
    function permitBusinessTarget(c, id) {
      let marker = request.resource.data.rawReversePermitRefV1;
      let path = permitPath(marker.permitId);
      let p = get(path).data;
      let b = p.businessWitness;
      return p.version == 3 && p.kind == 'raw-reverse-group' && p.actorUid == request.auth.uid
        && p.employeeId == me() && p.companyId == myCompany() && p.state == 'prepared'
        && getAfter(path).data.state == 'applied' && getAfter(path).data.diff(p).affectedKeys().hasOnly(['state'])
        && b.collection == c && b.id == id && b.beforeExists == true && b.afterExists == true
        && resource != null && resource.data == b.before && request.resource.data == b.after;
    }
    function rawWriterCollection(c) {
      return c in ['rawInventories', 'rawInventoryJobs', 'rawMaterialLedger', 'rawInventoryReversalGuards'];
    }
    // 일반 역분개와 압착의 correction 표시는 보존하고 실제 수동 정정 형태만 봉쇄한다.
    function rawManualCorrectionMarked(data) {
      let operation = data.get('operationId', '');
      let source = data.get('source', {}) is map ? data.get('source', {}) : {};
      let sourceId = source.get('id', '');
      let manualPrefix = operation is string && operation.matches('^(raw-manual-v1-|rm-corr-|rm-stocktake-).*');
      let sourcePrefix = sourceId is string && sourceId.matches('^(raw-manual-v1-|rm-corr-|rm-stocktake-).*');
      return manualPrefix || sourcePrefix || (data.get('type', '') == 'correction'
        && data.get('kind', '') in ['consume', 'receive', 'stocktake']
        && source.get('type', '') in ['adjustment', 'stocktake']);
    }
    // 서버가 원문과 함께 고정한 말단 효과는 웹에서 수정하지 않는다.
    function fullEffectWriteOk(c) {
      let guarded = c in ['rawMaterialLedger', 'rawInventoryReversalGuards', 'productionRecords'];
      return !guarded || (!(resource != null && 'fullEffectAuthority' in resource.data)
        && !(request.resource != null && 'fullEffectAuthority' in request.resource.data));
    }
    // 수동 박스 정정의 원료 효과는 최초 서버 증빙과 함께 불변으로 보관한다.
    function manualCorrectionEffectWriteOk(c) {
      return c != 'rawMaterialLedger' || (!(resource != null && 'orderManualCorrectionEffectAuthority' in resource.data)
        && !(request.resource != null && 'orderManualCorrectionEffectAuthority' in request.resource.data));
    }
    // 신규 원장은 원문과 가역 문서 주소를 묶는다. 긴 해시 주소는 별도 서버 경로가 필요하다.
    function rawCanonical(op) { return 'op_' + op.toUtf8().toBase64().replace('=+$', ''); }
    function rawLegacy(op) {
      let safe = op.replace('[/.$#]', '_').replace('\\[', '_').replace('\\]', '_').replace('\\\\', '_');
      let cut = safe.size() > 400 ? safe[0:400] : safe;
      return cut == '' || cut.matches('^__.*__$') ? 'op_' + cut : cut;
    }
    function rawProductionFrameOk(op, sourceId) {
      let n = int(op[4:10]);
      return op[4:10].matches('^[0-9]{6}$') && op[10:11] == ':' && n > 0
        && op[11:11+n] == sourceId && sourceId.size() == n && op[11+n:12+n] == ':'
        && op[12+n:].matches('^op_[A-Za-z0-9_-]+$');
    }
    function rawOriginalOk(original, data) {
      let source = original.get('source', {}) is map ? original.get('source', {}) : {};
      let sourceType = source.get('type', '');
      let sourceId = source.get('id', '');
      let legacyId = original.get('orderId', '');
      let orderSource = sourceType == 'production' || (sourceType == 'oem' && original.get('operationId', '').matches('^(production-ledger|pl2):.*'));
      let linkedId = orderSource ? sourceId : (sourceType == '' ? legacyId : '');
      let orderPath = /databases/$(database)/documents/orders/$(linkedId is string && linkedId.size() > 0 ? linkedId : '__invalid__');
      return original.get('operationId', null) == data.get('reversalOf', data.get('originalOperationId', null))
        && original.get('companyId', null) == data.get('companyId', null)
        && original.get('rawItemId', null) == data.get('rawItemId', null)
        && !('fullEffectAuthority' in original) && !('orderManualCorrectionEffectAuthority' in original)
        && (!orderSource || legacyId == '' || legacyId == sourceId)
        && (linkedId == '' || (linkedId is string && exists(orderPath) && get(orderPath).data.get('companyId', null) == data.companyId
          && !('orderProductionRefsV1' in get(orderPath).data)
          && (data.get('source', null) == null || data.source.get('id', null) == linkedId)));
    }
    function rawOriginalsOk(modern, legacy, data) {
      let mp = /databases/$(database)/documents/rawMaterialLedger/$(modern);
      let lp = /databases/$(database)/documents/rawMaterialLedger/$(legacy);
      let hasModern = exists(mp);
      let hasLegacy = exists(lp);
      let m = hasModern ? get(mp).data : {};
      let l = hasLegacy ? get(lp).data : {};
      return (hasModern || hasLegacy) && (!(hasModern && hasLegacy) || m == l)
        && (hasModern ? rawOriginalOk(m,data) : rawOriginalOk(l,data));
    }
    function rawManualReverseOk(id, data, guard) { return rawReverseFrameOk(id,data,guard); }
    function rawReverseFrameOk(id, data, guard) {
      let op = guard ? data.get('reverseOperationId', '') : data.get('operationId', '');
      let original = guard ? data.get('originalOperationId', '') : data.get('reversalOf', '');
      let modern = rawCanonical(original);
      let legacy = rawLegacy(original);
      let guardPath = /databases/$(database)/documents/rawInventoryReversalGuards/$(modern);
      let movementPath = /databases/$(database)/documents/rawMaterialLedger/$(rawCanonical(op));
      return op is string && op.size() > 0 && original is string && original.size() > 0
        && modern.size() <= 1403 && (!guard || id == modern) && rawOriginalsOk(modern,legacy,data)
        && (guard ? (!exists(movementPath) && getAfter(movementPath).data.get('operationId', null) == op
          && getAfter(movementPath).data.get('reversalOf', null) == original
          && getAfter(movementPath).data.get('companyId', null) == data.companyId)
          : (!exists(guardPath) && getAfter(guardPath).data.get('originalOperationId', null) == original
          && getAfter(guardPath).data.get('reverseOperationId', null) == op));
    }
    function rawOrderSourceOk(c, id, data) {
      let source = data.get('source', {}) is map ? data.get('source', {}) : {};
      let type = source.get('type', '');
      let sourceId = source.get('id', '');
      let op = data.get('operationId', '');
      let press = c == 'rawInventoryJobs' && type == 'production' && sourceId is string && sourceId.size() > 0
        && id == 'raw-press-' + rawCanonical(sourceId) && data.get('rawPressEvidence', {}) is map
        && data.rawPressEvidence.get('entry', {}) is map && data.rawPressEvidence.entry.get('id', null) == sourceId;
      let job = c == 'rawInventoryJobs' && type in ['production', 'production-reversal'] && !press;
      let orderPath = /databases/$(database)/documents/orders/$(sourceId is string && sourceId.size() > 0 ? sourceId : '__invalid__');
      return (c != 'rawMaterialLedger' || (op is string && op.size() > 0
          && (id == rawCanonical(op) || (op.toUtf8().toBase64().replace('=+$', '').size() > 1400 && !(type in ['production','oem']) && !op.matches('^(pr2|pl2|rv2):.*') && data.get('kind', '') != 'reverse'))
          && !op.matches('^production(-ledger)?:.*')
          && (!op.matches('^(pr2|pl2):.*') || ((type == 'production' && op[0:4] == 'pr2:' || type == 'oem' && op[0:4] == 'pl2:')
            && sourceId is string && rawProductionFrameOk(op, sourceId)))
          && (type != 'production' || op.matches('^pr2:.*'))
          && (!(data.get('kind', '') == 'reverse' || op.matches('^rv2:.*'))
            || (op.matches('^rv2:.*') ? rawReverseFrameOk(id,data,false) : rawManualReverseOk(id,data,false)))))
        && (c != 'rawInventoryReversalGuards' || (data.get('reverseOperationId', '').matches('^rv2:.*') ? rawReverseFrameOk(id,data,true) : rawManualReverseOk(id,data,true)))
        && (!(job || (c == 'rawMaterialLedger' && op.matches('^(pr2|pl2):.*'))) || (sourceId is string && sourceId.size() > 0
          && exists(orderPath) && get(orderPath).data.get('companyId', null) == data.companyId
          && !('orderProductionRefsV1' in get(orderPath).data)
          && (!(type == 'production' || (c == 'rawMaterialLedger' && op.matches('^(pr2|pl2):.*')))
            || !('legacyRecoveryRetirementV1' in get(orderPath).data)))); 
    }
    function rawOrderSourceWriteOk(c, id) {
      let before = resource == null ? {} : resource.data;
      let next = request.resource.data;
      return (resource != null && c in ['rawMaterialLedger','rawInventoryReversalGuards']
        && !('operationId' in before) && !('originalOperationId' in before) && !('reverseOperationId' in before)
        && next.diff(before).affectedKeys().hasOnly(['note','inventoryWriterProtocolVersion','inventoryWriteRevision']))
        || (rawOrderSourceOk(c, id, next)
        && (resource == null || (!(c in ['rawMaterialLedger', 'rawInventoryJobs'])
          || (next.get('source', null) == before.get('source', null) && next.get('operationId', null) == before.get('operationId', null))))
        && (resource == null || c != 'rawInventoryReversalGuards' || (next.get('originalOperationId', null) == before.get('originalOperationId', null) && next.get('reverseOperationId', null) == before.get('reverseOperationId', null))));
    }
    function rawWriterOk(c) {
      let before = resource == null ? {} : resource.data;
      return (c != 'rawMaterialLedger' || (!rawManualCorrectionMarked(before) && !rawManualCorrectionMarked(request.resource.data)))
        && (!(rawWriterCollection(c) || c == 'productionRecords') || writerAdvanced(before, request.resource.data, writerRevision(before)));
    }
    function itemTombstone(company, id) {
      return /databases/$(database)/documents/inventoryWriterDeletions/$(company + '__' + id);
    }
    // 서버 보호행을 웹이 제거하거나 같은 정확 행을 중복할 수 없다.
    function fullItemReservationsOk(before, next, creating) {
      let protected = before.get('fullReservationRows', []);
      let rows = next.get('inventoryReservations', []);
      return creating ? !('fullReservationRows' in next)
        : (('fullReservationRows' in before) == ('fullReservationRows' in next))
          && next.get('fullReservationRows', null) == before.get('fullReservationRows', null)
          && protected is list && (protected.size() == 0 || (rows is list
            && rows.hasAll(protected)
            && rows.size() == rows.removeAll(protected).size() + protected.size()));
    }
    // 서버 예약 하한은 클라이언트가 만들거나 고치거나 없앨 수 없다.
    function fullItemFloorOk(before, next, creating) {
      return creating ? !('serverReservedStockFloorV1' in next)
        : (('serverReservedStockFloorV1' in before) == ('serverReservedStockFloorV1' in next))
          && before.get('serverReservedStockFloorV1', null) == next.get('serverReservedStockFloorV1', null)
          && (!('serverReservedStockFloorV1' in before)
            || (before.serverReservedStockFloorV1 is number && before.serverReservedStockFloorV1 >= 0
              && next.get('stock', null) is number && next.stock >= before.serverReservedStockFloorV1));
    }
    function itemWriteOk(id) {
      let before = resource == null ? {} : resource.data;
      let next = request.resource.data;
      let tomb = itemTombstone(next.companyId, id);
      let floor = resource == null && exists(tomb) ? get(tomb).data.lastDeletedItemRevision : writerRevision(before);
      return fullItemFloorOk(before, next, resource == null)
        && fullItemReservationsOk(before, next, resource == null)
        && !(exists(tomb) && get(tomb).data.get('mergedIntoItemId', null) != null) && (resource == null
        ? writerAdvanced(before, next, floor)
        : next.diff(before).affectedKeys().hasAny(['stock', 'lots', 'inventoryReservations', 'stocktakeAnchors', 'allocated', 'inventoryAllocations'])
          ? writerAdvanced(before, next, writerRevision(before)) : writerPreserved(before, next));
    }
    function itemDeleteOk(id) {
      let tomb = itemTombstone(resource.data.companyId, id);
      let prior = exists(tomb) ? get(tomb).data.deletionRevision : 0;
      let after = getAfter(tomb).data;
      return !('serverReservedStockFloorV1' in resource.data) && !('rawReversePermitRefV1' in resource.data)
        && resource.data.get('fullReservationRows', []) is list
        && resource.data.get('fullReservationRows', []).size() == 0
        && writerBeforeOk(resource.data) && after.companyId == resource.data.companyId && after.itemId == id
        && after.inventoryWriterProtocolVersion == 1 && after.beforeRevision == writerRevision(resource.data)
        && after.lastDeletedItemRevision == writerRevision(resource.data) && after.deletionRevision == prior + 1;
    }
    match /items/{id} {
      allow get: if getOk();
      allow list: if readOk();
      allow create, update: if createUpdateOk() && ((permitMarkerPreserved(resource == null ? {} : resource.data, request.resource.data)
          && inventoryQuantityOk('items') && itemWriteOk(id))
        || (permitMarkerValid(request.resource.data.get('rawReversePermitRefV1', null)) && permitRawTarget('items',id)));
      allow delete: if deleteOk() && itemDeleteOk(id);
    }
    match /inventoryWriterDeletions/{id} {
      allow get: if getOk();
      allow list: if readOk();
      allow create, update: if createUpdateOk()
        && request.resource.data.get('mergedIntoItemId', null) == null
        && request.resource.data.get('mergeOperationId', null) == null
        && (resource == null || resource.data.get('mergedIntoItemId', null) == null)
        && request.resource.data.itemId is string && request.resource.data.itemId.size() > 0
        && id == request.resource.data.companyId + '__' + request.resource.data.itemId
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && !existsAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && request.resource.data.inventoryWriterProtocolVersion == 1
        && request.resource.data.beforeRevision == writerRevision(get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data)
        && request.resource.data.lastDeletedItemRevision == request.resource.data.beforeRevision
        && request.resource.data.deletionRevision is int
        && request.resource.data.deletionRevision <= 9007199254740991
        && request.resource.data.deletionRevision == (resource == null ? 1 : resource.data.deletionRevision + 1);
      allow delete: if false;
    }
    function orderListCanonicalUtc(value) {
      return value is string && value.size() == 24 && value.matches('^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$');
    }
    function orderListProjectionValid(next) {
      let projection = next.get('orderListProjection', null);
      let bounded = next.get('status', '') == 'DELIVERED' && orderListCanonicalUtc(next.get('deliveredAt', null))
        && orderListCanonicalUtc(next.get('deliveryDate', null)) && orderListCanonicalUtc(next.get('createdAt', null));
      return projection is map && projection.keys().hasAll(['version', 'candidateDay']) && projection.keys().hasOnly(['version', 'candidateDay'])
        && projection.version is int && projection.version == 1 && projection.candidateDay is string
        && projection.candidateDay == (bounded ? next.deliveredAt.split('T')[0] : '9999-12-31');
    }
    function orderListProjectionWriteOk() {
      let before = resource == null ? {} : resource.data;
      let next = request.resource.data;
      return (resource != null && !('orderListProjection' in before) && !('orderListProjection' in next)
        && !next.diff(before).affectedKeys().hasAny(['status', 'deliveredAt', 'deliveryDate', 'createdAt']))
        || orderListProjectionValid(next);
    }
    function orderWriteOk() {
      let before = resource == null ? {} : resource.data;
      let next = request.resource.data;
      let sensitive = ['status', 'items', 'inventoryOperation', 'inventoryGenerationCompletion', 'productionRecordIndex',
        'producedAt', 'shippedOut', 'productConsumedLots', 'rawConsumedLots', 'itemInventory', 'inventorySnapshots', 'rawInventoryAttempt', 'deliveredAt'];
      let fullSensitive = sensitive.concat(['producedUnits', 'rawLotsDeducted', 'autoBuilt']);
      return (resource == null ? !('inventoryExecutionProtocol' in next)
          : (('inventoryExecutionProtocol' in before) == ('inventoryExecutionProtocol' in next)
            && before.get('inventoryExecutionProtocol', null) == next.get('inventoryExecutionProtocol', null)))
        && (!('inventoryExecutionProtocol' in before) || !next.diff(before).affectedKeys().hasAny(fullSensitive))
        && (resource == null ? !('orderProductionRefsV1' in next)
          : (('orderProductionRefsV1' in before) == ('orderProductionRefsV1' in next)
            && before.get('orderProductionRefsV1', null) == next.get('orderProductionRefsV1', null)))
        && (!('orderProductionRefsV1' in before) || !next.diff(before).affectedKeys().hasAny(fullSensitive))
        && (resource == null ? !('orderManualCorrectionRefsV1' in next)
          : (('orderManualCorrectionRefsV1' in before) == ('orderManualCorrectionRefsV1' in next)
            && before.get('orderManualCorrectionRefsV1', null) == next.get('orderManualCorrectionRefsV1', null)))
        && (!('orderManualCorrectionRefsV1' in before) || !next.diff(before).affectedKeys().hasAny(fullSensitive))
        && (resource == null ? !('legacyRecoveryRetirementV1' in next)
          : (('legacyRecoveryRetirementV1' in before) == ('legacyRecoveryRetirementV1' in next)
            && before.get('legacyRecoveryRetirementV1', null) == next.get('legacyRecoveryRetirementV1', null)))
        && next.get('retirementId', null) == before.get('retirementId', null)
        && next.get('retirementClaimPending', null) == before.get('retirementClaimPending', null)
        && !(before.get('retirementClaimPending', false) == true && next.get('inventoryOperation', null) != before.get('inventoryOperation', null))
        && (resource == null || next.diff(before).affectedKeys().hasAny(sensitive)
          ? writerAdvanced(before, next, writerRevision(before)) : writerPreserved(before, next));
    }
    function catalogOrderReferenceOk(id) {
      let before = resource == null ? {} : resource.data;
      let next = request.resource.data;
      let epoch = /databases/$(database)/documents/catalogItemMergeState/$(next.companyId);
      let active = ['PENDING', 'PROCESSING', 'DISPATCHED', 'SHIPPED', 'ON_HOLD'];
      let required = next.get('status', '') in active && (resource == null || !(before.get('status', '') in active) || next.get('items', []) != before.get('items', []));
      let proofId = next.get('catalogReferenceProofId', '');
      let proofPath = /databases/$(database)/documents/catalogOrderReferenceProofs/$(proofId);
      return !required || !existsAfter(epoch) || (proofId is string && proofId.size() > 0 && existsAfter(proofPath)
        && getAfter(proofPath).data.companyId == next.companyId
        && getAfter(proofPath).data.actorUid == request.auth.uid
        && getAfter(proofPath).data.orderId == id
        && getAfter(proofPath).data.orderExists == (resource != null)
        && getAfter(proofPath).data.beforeRevision == writerRevision(before)
        && getAfter(proofPath).data.catalogRevision == getAfter(epoch).data.revision
        && getAfter(proofPath).data.status == next.status
        && getAfter(proofPath).data.items == next.items);
    }
    function catalogPurchaseProjectionMatches(projection, value) {
      let fields = ['itemId', 'items', 'oemSent', 'status', 'oemIssueStatus', 'oemCancelledAt'];
      return projection.keys().toSet() == value.keys().toSet().intersection(fields.toSet())
        && !projection.diff(value).affectedKeys().hasAny(fields);
    }
    function catalogPurchaseActive(value) {
      return value.get('status', '') != 'cancelled' && value.get('oemCancelledAt', null) in [null, false, '', 0]
        && (value.get('status', '') in ['pending', 'invoiced'] || value.get('oemIssueStatus', '') in ['processing', 'failed']);
    }
    function catalogPurchaseReferenceOk(id) {
      let before = resource == null ? {} : resource.data;
      let next = request.resource.data;
      let fields = ['itemId', 'items', 'oemSent', 'status', 'oemIssueStatus', 'oemCancelledAt'];
      let required = catalogPurchaseActive(next) && (resource == null || !catalogPurchaseActive(before) || next.diff(before).affectedKeys().hasAny(fields));
      let epoch = /databases/$(database)/documents/catalogItemMergeState/$(next.companyId);
      let proofId = next.get('catalogReferenceProofId', '');
      let proofPath = /databases/$(database)/documents/catalogOrderReferenceProofs/$(proofId);
      return !required || !existsAfter(epoch) || (proofId is string && proofId.size() > 0 && existsAfter(proofPath)
        && getAfter(proofPath).data.collection == 'purchaseOrders'
        && getAfter(proofPath).data.companyId == next.companyId
        && getAfter(proofPath).data.actorUid == request.auth.uid
        && getAfter(proofPath).data.orderId == id
        && getAfter(proofPath).data.orderExists == (resource != null)
        && getAfter(proofPath).data.catalogRevision == getAfter(epoch).data.revision
        && catalogPurchaseProjectionMatches(getAfter(proofPath).data.beforeProjection, before)
        && catalogPurchaseProjectionMatches(getAfter(proofPath).data.nextProjection, next));
    }
    match /catalogItemMergeReceipts/{id} {
      allow read, write: if false;
    }
    match /catalogItemMergeState/{id} {
      allow get: if isEmployee() && id == request.auth.token.companyId;
      allow list, write: if false;
    }
    match /catalogOrderReferenceProofs/{id} {
      allow get: if isEmployee() && resource.data.companyId == request.auth.token.companyId && resource.data.actorUid == request.auth.uid;
      allow list, write: if false;
    }
    function orderDeleteOk(id) {
      let operation = resource.data.get('inventoryOperation', {});
      let audit = /databases/$(database)/documents/orderStatusAudits/$(operation.id);
      let after = getAfter(audit).data;
      return !('inventoryExecutionProtocol' in resource.data) && !('legacyRecoveryRetirementV1' in resource.data)
        && !('orderManualCorrectionRefsV1' in resource.data)
        && writerBeforeOk(resource.data) && !exists(audit) && after.companyId == resource.data.companyId
        && after.orderId == id && after.id == operation.id && after.state == 'completed'
        && after.cancellation.action == 'delete' && after.cancellation.deleted == true
        && after.beforeOrderWriteRevision == writerRevision(resource.data)
        && after.inventoryWriterProtocolVersion == 1 && after.inventoryWriteRevision == 1;
    }
    match /orders/{id} {
      allow get: if getOk();
      allow list: if readOk();
      allow create, update: if createUpdateOk() && orderWriteOk() && catalogOrderReferenceOk(id) && orderListProjectionWriteOk();
      allow delete: if deleteOk() && orderDeleteOk(id);
    }
    match /purchaseOrders/{id} {
      allow get: if isEmployee() && getOk();
      allow list: if isEmployee() && readOk();
      allow create, update: if isEmployee() && createUpdateOk() && inventoryQuantityOk('purchaseOrders')
        && rawWriterOk('purchaseOrders') && oemCostFieldsOk('purchaseOrders') && catalogPurchaseReferenceOk(id) && payrollWriteAllowed('purchaseOrders');
      allow delete: if isEmployee() && deleteOk() && resource.data.get('oemBatchCost', null) == null && payrollWriteAllowed('purchaseOrders');
    }
    match /rawInventories/{id} {
      allow get: if isEmployee() && getOk();
      allow list: if isEmployee() && readOk();
      allow create, update: if isEmployee() && createUpdateOk() && ((permitMarkerPreserved(resource == null ? {} : resource.data, request.resource.data)
          && inventoryQuantityOk('rawInventories') && rawWriterOk('rawInventories'))
        || (permitMarkerValid(request.resource.data.get('rawReversePermitRefV1', null)) && permitRawTarget('rawInventories',id)));
      allow delete: if false;
    }
    // 원장과 취소가드는 단일 문서 ID를 원문과 대조한다. 포괄 규칙의 OR 경로는 제외한다.
    match /{rawCollection}/{rawId} {
      allow get: if rawCollection in ['rawMaterialLedger','rawInventoryReversalGuards','rawInventoryJobs'] && isEmployee() && getOk();
      allow list: if rawCollection in ['rawMaterialLedger','rawInventoryReversalGuards','rawInventoryJobs'] && isEmployee() && readOk();
      allow create, update: if rawCollection in ['rawMaterialLedger','rawInventoryReversalGuards','rawInventoryJobs'] && isEmployee()
        && createUpdateOk() && ((permitMarkerPreserved(resource == null ? {} : resource.data,request.resource.data)
            && rawOrderSourceWriteOk(rawCollection,rawId) && rawWriterOk(rawCollection)
            && fullEffectWriteOk(rawCollection) && manualCorrectionEffectWriteOk(rawCollection))
          || (permitMarkerValid(request.resource.data.get('rawReversePermitRefV1', null))
            && (rawCollection == 'rawInventoryJobs' ? permitBusinessTarget(rawCollection,rawId) : permitRawTarget(rawCollection,rawId))));
    }
    // ── 나머지 업무 컬렉션 ──────────────────────────────────────
    //  **회사가 안 적힌 문서는 아무도 못 읽고 못 쓴다.** 2026-09-16 에 4,883건을 채워
    //  지금은 빈 문서가 0건이다. 새로 만드는 문서에도 반드시 붙여야 한다 —
    //  안 붙이면 저장하는 족족 여기서 막힌다(그게 의도다. 조용히 새는 것보다 낫다).
    match /{collection}/{document=**} {
      allow get: if !hasOwnRule(collection) && !isProtectedCutoverPath()
                 && (adminOnlyCollection(collection) ? isAdmin() : isEmployee())
                 && getOk();
      // 목록 요청에는 개별 문서 경로가 없어 전환 설정만 제외할 수 없다. 앱은 메타 단건 조회만 쓴다.
      allow list: if !hasOwnRule(collection) && collection != 'appMeta'
                  && (adminOnlyCollection(collection) ? isAdmin() : isEmployee())
                  && readOk();
      allow create, update: if !hasOwnRule(collection) && !isProtectedCutoverPath() && !workOrderProtectedPath()
                            && (adminOnlyCollection(collection) ? isAdmin() : isEmployee())
                            && createUpdateOk()
                            && inventoryQuantityOk(collection)
                            && (!rawWriterCollection(collection) || rawOrderSourceWriteOk(collection, ''))
                            && rawWriterOk(collection)
                            && fullEffectWriteOk(collection)
                            && manualCorrectionEffectWriteOk(collection)
                            && oemCostFieldsOk(collection)
                            && payrollWriteAllowed(collection);
      allow delete: if !hasOwnRule(collection) && !isProtectedCutoverPath() && !workOrderProtectedPath()
                    && (adminOnlyCollection(collection) ? isAdmin() : isEmployee())
                    && deleteOk()
                    && !rawWriterCollection(collection)
                    && fullEffectWriteOk(collection)
                    && manualCorrectionEffectWriteOk(collection)
                    && (collection != 'purchaseOrders' || resource.data.get('oemBatchCost', null) == null)
                    && payrollWriteAllowed(collection);
    }
  }
}

